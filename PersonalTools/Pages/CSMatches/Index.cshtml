                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" type="button" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/page-cs-match-tracker.js" asp-append-version="true"></script>
    <script>
        let CURRENT_PROFILE_ID = '@(Model.ProfileId?.ToString("D") ?? "default")';

        function profileQuery(prefix) {
            return CURRENT_PROFILE_ID !== 'default' ? prefix + 'profileId=' + encodeURIComponent(CURRENT_PROFILE_ID) : '';
        }

        // Tab switching is entirely client-side: the set of tabs never changes when switching
        // between them, only which one is active, so there's nothing to fetch for the tab bar
        // itself. Stats reload via the existing /api/csmatches/stats endpoint, and the match
        // table/cards reload via csMatchTracker (page-cs-match-tracker.js).
        function csMatchesSwitchProfile(profileId, profileName, pushHistory) {
            $('#profileTabs .nav-link').removeClass('active');
            $('#profileTabs .nav-link[data-profile-id="' + profileId + '"]').addClass('active');
            $('#profileTabs .csm-tab-close').addClass('d-none');
            $('#profileTabs .csm-tab-close[data-profile-id="' + profileId + '"]').removeClass('d-none');

            $('#editProfileId, #deleteProfileId, #addMapProfileId').val(profileId);
            $('#deleteProfileName').text(profileName || '');

            const href = profileId ? ('?ProfileId=' + encodeURIComponent(profileId)) : '?ProfileId=';
            if (pushHistory) {
                window.history.pushState({ profileId: profileId }, '', href);
            }

            CURRENT_PROFILE_ID = profileId || 'default';
            STAT_FILTER_KEY = 'csMatchesStatFilters:' + CURRENT_PROFILE_ID;

            $.getJSON('/api/csmatches/stats' + profileQuery('?')).done(renderStats);
            window.csMatchTracker.setProfile(profileId || null);

            applyStatFilterInputs();
            const filters = loadStatFilters();
            if (filters.activeDutyOnly || (Array.isArray(filters.excludedGameTypes) && filters.excludedGameTypes.length)) {
                refreshStats();
            } else {
                $('#mapPoolSuggestionBanner').addClass('d-none');
            }
        }

        $(document).on('click', '#profileTabs .nav-link', function (event) {
            event.preventDefault();
            const $tab = $(this);
            if ($tab.hasClass('active')) return;
            csMatchesSwitchProfile($tab.data('profile-id') || '', $tab.data('profile-name') || '', true);
        });

        window.addEventListener('popstate', function () {
            const params = new URLSearchParams(window.location.search);
            const profileId = params.get('ProfileId') || '';
            const $tab = $('#profileTabs .nav-link[data-profile-id="' + profileId + '"]');
            csMatchesSwitchProfile(profileId, $tab.data('profile-name') || '', false);
        });

        $(document).on('click', '.js-edit-profile', function () {
            $('#editProfileId').val($(this).data('profile-id'));
            $('#editProfileName').val($(this).data('profile-name'));
            $('#editProfileSteamId').val($(this).data('profile-steamid'));
            $('#editProfileSteamId').closest('.js-steam-lookup').find('.js-steam-lookup-result').addClass('d-none').empty();
        });

        // Delete-all button reflects whether the active profile currently has any matches.
        $(document).on('csMatches:loaded', function (_event, detail) {
            $('#deleteAllMatchesBtn').prop('disabled', detail.count === 0);
        });

        const STAT_STORAGE_KEY = 'csMatchesStatVisibility';

        function loadStatVisibility() {
            try {
                const raw = localStorage.getItem(STAT_STORAGE_KEY);
                return raw ? JSON.parse(raw) : {};
            } catch (e) {
                return {};
            }
        }

        function saveStatVisibility(map) {
            localStorage.setItem(STAT_STORAGE_KEY, JSON.stringify(map));
        }

        function applyStatVisibility() {
            const visibility = loadStatVisibility();

            $('.js-stat').each(function () {
                const key = $(this).data('stat-key');
                $(this).toggle(visibility[key] !== false);
            });

            $('.js-stat-toggle').each(function () {
                const key = $(this).data('stat-key');
                $(this).prop('checked', visibility[key] !== false);
            });
        }

        $(document).on('change', '.js-stat-toggle', function () {
            const visibility = loadStatVisibility();
            const key = $(this).data('stat-key');
            visibility[key] = $(this).is(':checked');
            saveStatVisibility(visibility);
            applyStatVisibility();
        });

        applyStatVisibility();

        // Clicking anywhere on an Edit Stats card toggles its switch - except the label (which
        // already natively toggles the checkbox it's "for", so handling it too would double-toggle)
        // and the tooltip info icon (which needs its own hover/click for the tooltip to work).
        $(document).on('click', '.csm-toggle-cell', function (event) {
            if ($(event.target).closest('label, input, i.fa-solid').length) return;
            const $checkbox = $(this).find('input[type="checkbox"]');
            $checkbox.prop('checked', !$checkbox.prop('checked')).trigger('change');
        });

        $(function () {
            $('[data-bs-toggle="tooltip"]').each(function () {
                new bootstrap.Tooltip(this);
            });
        });

        // Match view: list (default) vs cards, persisted per browser.
        const VIEW_STORAGE_KEY = 'csMatchesViewMode';

        function applyMatchView(view) {
            const isList = view !== 'cards';
            $('#csMatchTableWrap').toggleClass('d-none', !isList);
            $('#matchCardView').toggleClass('d-none', isList);
            $('.js-view-toggle').removeClass('active');
            $('.js-view-toggle[data-view="' + view + '"]').addClass('active');
        }

        $(document).on('click', '.js-view-toggle', function () {
            const view = $(this).data('view');
            localStorage.setItem(VIEW_STORAGE_KEY, view);
            applyMatchView(view);
        });

        const savedMatchView = localStorage.getItem(VIEW_STORAGE_KEY);
        // Preserve an explicit browser choice, but do not make a first-time mobile visitor
        // pinch and scroll a dense table when the card layout is already available.
        applyMatchView(savedMatchView || (window.matchMedia('(max-width: 767.98px)').matches ? 'cards' : 'list'));

        // #6 — Add New Map opened from within Add/Edit Match should return to that modal on close
        let csMatchOriginModalId = null;

        $(document).on('click', '.js-open-add-map', function () {
            const $originModal = $(this).closest('.modal');
            csMatchOriginModalId = '#' + $originModal.attr('id');
        });

        $('#addMapModal').on('show.bs.modal', function () {
            if (csMatchOriginModalId) {
                bootstrap.Modal.getOrCreateInstance($(csMatchOriginModalId)[0]).hide();
            }
        });

        $('#addMapModal').on('hidden.bs.modal', function () {
            if (csMatchOriginModalId) {
                bootstrap.Modal.getOrCreateInstance($(csMatchOriginModalId)[0]).show();
                csMatchOriginModalId = null;
            }
        });

        // Fetch matches from Leetify
        const leetifyModal = document.getElementById('fetchLeetifyModal');
        const MAP_IMAGES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Maps.ToDictionary(m => m.Name, m => m.ImagePath)));

        $('#fetchLeetifyBtn').on('click', function () {
            if ($(this).data('steam-linked') !== true) {
                window.location.href = '/Settings?steamRequired=true';
                return;
            }

            bootstrap.Modal.getOrCreateInstance(leetifyModal).show();
        });

        $(leetifyModal).on('show.bs.modal', function () {
            $('#leetifyLoading').removeClass('d-none');
            $('#leetifyError').addClass('d-none');
            $('#leetifyContent').addClass('d-none');
            $('#leetifyImportBtn').prop('disabled', true);
            $('#leetifySelectedCount').text('0');

            $.getJSON('/api/csmatches/leetify' + profileQuery('?'))
                .done(function (matches) {
                    renderLeetifyMatches(matches);
                    $('#leetifyLoading').addClass('d-none');
                    $('#leetifyContent').removeClass('d-none');
                })
                .fail(function (xhr) {
                    $('#leetifyLoading').addClass('d-none');
                    $('#leetifyError').text(xhr.responseJSON?.message || 'Could not load matches from Leetify.').removeClass('d-none');
                });
        });

        function renderLeetifyMatches(matches) {
            const $rows = $('#leetifyMatchRows').empty();
            const $gameTypeFilters = $('#leetifyGameTypeFilters').empty();
            const gameTypes = [...new Set(matches.map(m => m.gameType))];

            $('#leetifyFetchedCount').text(matches.length);

            gameTypes.forEach(gt => {
                $gameTypeFilters.append(
                    $('<button type="button" class="csm-gt-pill on leetify-gt-filter">').data('gametype', gt).text(gt)
                );
            });

            matches.forEach(match => {
                const isWin = match.teamScore > match.opponentScore;
                const mapImage = MAP_IMAGES[match.mapName];
                const sideImage = match.startSide === 'CT' ? '/images/cs/teams/ct.png' : '/images/cs/teams/t.png';

                const $row = $('<tr>').attr('data-gametype', match.gameType);

                const $checkbox = $('<input type="checkbox" class="form-check-input leetify-match-check">')
                    .prop('disabled', match.alreadyImported)
                    .val(match.leetifyMatchId);

                const $mapCell = $('<td class="csm-match-cell">');
                if (mapImage) {
                    $mapCell.append($('<img class="csm-thumb" alt="" style="width:44px;height:30px;">').attr('src', mapImage));
                }
                $mapCell.append($('<span>').text(match.mapName));
                if (match.overtimeCount > 0) {
                    $mapCell.append($('<span class="csm-ot-chip">').text('OT' + match.overtimeCount));
                }

                $row.append(
                    $('<td>').append($checkbox),
                    $('<td>').text(new Date(match.playedAtUtc).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })),
                    $mapCell,
                    $('<td>').text(match.gameType),
                    $('<td>').append($('<img class="csm-side-icon" alt="" style="width:22px;height:22px;">').attr('src', sideImage).attr('title', 'Started ' + match.startSide)),
                    $('<td>').text(`${match.teamScore} - ${match.opponentScore}`),
                    $('<td>').append(
                        match.alreadyImported
                            ? $('<span class="csm-already-badge">Already added</span>')
                            : $('<span>').addClass(isWin ? 'win' : 'loss').text(isWin ? 'Win' : 'Loss')
                    )
                );

                if (match.alreadyImported) {
                    $row.addClass('leetify-row-imported');
                }

                $rows.append($row);
            });

            applyLeetifyFilters();
        }

        function applyLeetifyFilters() {
            const activeGameTypes = $('.leetify-gt-filter.on').map(function () { return $(this).data('gametype'); }).get();
            let visible = 0;

            $('#leetifyMatchRows tr').each(function () {
                const $row = $(this);
                const matches = activeGameTypes.includes($row.data('gametype'));

                $row.toggle(matches);

                if (matches) {
                    visible++;
                }
            });

            $('#leetifyEmptyMessage').toggleClass('d-none', visible !== 0);
            updateLeetifySelectedCount();
        }

        $(document).on('click', '.leetify-gt-filter', function () {
            $(this).toggleClass('on');
            applyLeetifyFilters();
        });

        // Clicking a row toggles its checkbox, same as clicking the checkbox itself - except when
        // the click IS on the checkbox (native toggle already handles that) or the row is an
        // already-imported match (checkbox disabled, nothing to toggle).
        $(document).on('click', '#leetifyMatchRows tr', function (event) {
            if ($(event.target).is('input')) return;
            const $checkbox = $(this).find('.leetify-match-check');
            if ($checkbox.prop('disabled')) return;
            $checkbox.prop('checked', !$checkbox.prop('checked')).trigger('change');
        });

        $(document).on('click', '#leetifySelectAllBtn', function () {
            const $rows = $('#leetifyMatchRows tr:visible .leetify-match-check:not(:disabled)');
            const allSelected = $rows.length > 0 && $rows.length === $rows.filter(':checked').length;
            $rows.prop('checked', !allSelected);
            updateLeetifySelectedCount();
        });

        $(document).on('change', '.leetify-match-check', updateLeetifySelectedCount);

        function updateLeetifySelectedCount() {
            const count = $('.leetify-match-check:checked').length;
            $('#leetifySelectedCount').text(count);
            $('#leetifyImportBtn').prop('disabled', count === 0);

            const $selectable = $('#leetifyMatchRows tr:visible .leetify-match-check:not(:disabled)');
            const allSelected = $selectable.length > 0 && $selectable.length === $selectable.filter(':checked').length;
            $('#leetifySelectAllBtn').text(allSelected ? 'Deselect all' : 'Select all');
        }

        $('#leetifyImportBtn').on('click', function () {
            const ids = $('.leetify-match-check:checked').map(function () { return $(this).val(); }).get();

            if (!ids.length) {
                return;
            }

            const $btn = $(this).prop('disabled', true);

            $.ajax({
                url: '/api/csmatches/leetify/import' + profileQuery('?'),
                method: 'POST',
                contentType: 'application/json',
                headers: { RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val() },
                data: JSON.stringify(ids)
            }).done(function () {
                bootstrap.Modal.getInstance(leetifyModal)?.hide();
                window.csMatchTracker.reload();
            }).fail(function (xhr) {
                $('#leetifyError').text(xhr.responseJSON?.message || 'Could not import the selected matches.').removeClass('d-none');
                $btn.prop('disabled', false);
            });
        });

        // Edit Stats: game type / Active Duty filters (persisted per profile tab)
        let STAT_FILTER_KEY = 'csMatchesStatFilters:' + CURRENT_PROFILE_ID;

        function loadStatFilters() {
            try {
                const raw = localStorage.getItem(STAT_FILTER_KEY);
                return raw ? JSON.parse(raw) : {};
            } catch (e) {
                return {};
            }
        }

        function saveStatFilters(filters) {
            localStorage.setItem(STAT_FILTER_KEY, JSON.stringify(filters));
        }

        function applyStatFilterInputs() {
            const filters = loadStatFilters();
            $('#statFilter-activeDutyOnly').prop('checked', filters.activeDutyOnly === true);
            $('.js-stat-gametype-toggle').each(function () {
                const gt = $(this).data('gametype');
                const excluded = Array.isArray(filters.excludedGameTypes) && filters.excludedGameTypes.includes(gt);
                $(this).prop('checked', !excluded);
            });
        }

        function renderStats(stats) {
            $('.js-stat[data-stat-key="totalMatches"] .js-stat-value').text(stats.totalMatches);
            $('.js-stat[data-stat-key="winsLosses"] .js-stat-value').html(`<span class="win">${stats.wins}</span> / <span class="loss">${stats.losses}</span>`);
            $('.js-stat[data-stat-key="totalWinRate"] .js-stat-value').text(stats.winRate + '%');
            $('.js-stat[data-stat-key="winRateCT"] .js-stat-value').text(stats.winRateCTStart + '%');
            $('.js-stat[data-stat-key="winRateT"] .js-stat-value').text(stats.winRateTStart + '%');
            $('.js-stat[data-stat-key="overtimeGames"] .js-stat-value').text(`${stats.overtimeGames} (${stats.overtimeGamePercentage}%)`);
            $('.js-stat[data-stat-key="otWinLoss"] .js-stat-value').html(`<span class="win">${stats.overtimeWins}</span> / <span class="loss">${stats.overtimeLosses}</span>`);
            $('.js-stat[data-stat-key="avgScoreMargin"] .js-stat-value').text(stats.averageScoreMargin);

            $('.js-stat[data-stat-key="currentStreak"] .js-stat-value')
                .removeClass('win loss')
                .addClass(stats.currentStreakType === 'Win' ? 'win' : 'loss')
                .text(stats.currentStreak > 0 ? `${stats.currentStreak} ${stats.currentStreakType}${stats.currentStreak > 1 ? 's' : ''}` : '-');

            const mapStat = (key, name, rate) => $('.js-stat[data-stat-key="' + key + '"] .js-stat-value').text(name ? `${name} (${rate}%)` : '-');
            mapStat('bestMap', stats.bestMap, stats.bestMapWinRate);
            mapStat('worstMap', stats.worstMap, stats.worstMapWinRate);
            mapStat('bestMapCT', stats.bestMapCTStart, stats.bestMapCTStartWinRate);
            mapStat('bestMapT', stats.bestMapTStart, stats.bestMapTStartWinRate);
        }

        const EMPTY_STATS = {
            totalMatches: 0, wins: 0, losses: 0, winRate: 0, winRateCTStart: 0, winRateTStart: 0,
            bestMap: null, bestMapWinRate: 0, worstMap: null, worstMapWinRate: 0,
            bestMapCTStart: null, bestMapCTStartWinRate: 0, bestMapTStart: null, bestMapTStartWinRate: 0,
            overtimeGames: 0, overtimeGamePercentage: 0, overtimeWins: 0, overtimeLosses: 0,
            currentStreak: 0, currentStreakType: '', averageScoreMargin: 0
        };

        function refreshStats() {
            const activeDutyOnly = $('#statFilter-activeDutyOnly').is(':checked');
            const includedGameTypes = $('.js-stat-gametype-toggle:checked').map(function () { return $(this).data('gametype'); }).get();

            $('#mapPoolSuggestionBanner').toggleClass('d-none', !activeDutyOnly);

            if (includedGameTypes.length === 0) {
                renderStats(EMPTY_STATS);
                return;
            }

            let query = '?activeDutyOnly=' + activeDutyOnly;
            includedGameTypes.forEach(gt => query += '&gameTypes=' + encodeURIComponent(gt));
            if (CURRENT_PROFILE_ID !== 'default') {
                query += '&profileId=' + encodeURIComponent(CURRENT_PROFILE_ID);
            }

            $.getJSON('/api/csmatches/stats' + query).done(renderStats);
        }

        $(document).on('change', '#statFilter-activeDutyOnly, .js-stat-gametype-toggle', function () {
            saveStatFilters({
                activeDutyOnly: $('#statFilter-activeDutyOnly').is(':checked'),
                excludedGameTypes: $('.js-stat-gametype-toggle:not(:checked)').map(function () { return $(this).data('gametype'); }).get()
            });
            refreshStats();
        });

        applyStatFilterInputs();

        const initialStatFilters = loadStatFilters();
        if (initialStatFilters.activeDutyOnly || (Array.isArray(initialStatFilters.excludedGameTypes) && initialStatFilters.excludedGameTypes.length)) {
            refreshStats();
        } else {
            $('#mapPoolSuggestionBanner').addClass('d-none');
        }

        window.csMatchTracker.init(CURRENT_PROFILE_ID !== 'default' ? CURRENT_PROFILE_ID : null);
    </script>
}
