@* Fetch Matches Modal *@
<div class="modal fade" id="fetchLeetifyModal" tabindex="-1" aria-labelledby="fetchLeetifyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h2 class="modal-title h5" id="fetchLeetifyModalLabel">Fetch matches from Leetify</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="leetifyLoading" class="text-center py-4">
                    <i class="fa-solid fa-circle-notch fa-spin me-2"></i>Loading matches from Leetify&hellip;
                </div>

                <div id="leetifyError" class="alert alert-danger d-none"></div>

                <div id="leetifyContent" class="d-none">
                    <div class="csm-filter-row">
                        <div class="csm-gt-pills" id="leetifyGameTypeFilters"></div>
                        <span class="csm-fetch-count">
                            <span id="leetifyFetchedCount">0</span> matches fetched
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="Leetify's public API only ever returns your 100 most recent matches — older matches can't be fetched here."></i>
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="csm-fetch-table">
                            <thead>
                                <tr>
                                    <th style="width: 2rem;"></th>
                                    <th>Date</th>
                                    <th>Map</th>
                                    <th>Game type</th>
                                    <th>Side</th>
                                    <th>Score</th>
                                    <th>Result</th>
                                </tr>
                            </thead>
                            <tbody id="leetifyMatchRows"></tbody>
                        </table>
                    </div>

                    <p class="small-muted mb-0 d-none" id="leetifyEmptyMessage">No matches found for the selected filters.</p>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-outline-secondary" type="button" id="leetifySelectAllBtn">Select all</button>
                <button class="btn btn-primary" type="button" id="leetifyImportBtn" disabled>
                    Import selected (<span id="leetifySelectedCount">0</span>)
                </button>
            </div>
        </div>
    </div>
</div>

@* Edit Stats Modal *@
<div class="modal fade" id="editStatsModal" tabindex="-1" aria-labelledby="editStatsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h2 class="modal-title h5" id="editStatsModalLabel">Edit Stats</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="small-muted mb-3">Choose which stats to show at the top of the page. Click a card to toggle it.</p>

                <div class="csm-toggle-grid">
                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-totalMatches">Total Matches</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The total number of matches you've logged."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="totalMatches" id="statToggle-totalMatches">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-winsLosses">Wins / Losses</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="Your total number of match wins versus losses."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="winsLosses" id="statToggle-winsLosses">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-totalWinRate">Total Win Rate</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The percentage of all logged matches you've won."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="totalWinRate" id="statToggle-totalWinRate">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-winRateCT">Win Rate (CT Start)</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="Your win rate in matches where you started on the CT side."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="winRateCT" id="statToggle-winRateCT">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-winRateT">Win Rate (T Start)</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="Your win rate in matches where you started on the T side."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="winRateT" id="statToggle-winRateT">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-winRateGameType">Win Rate by Game Type</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="Your win rate broken down by game type (e.g. Competitive, Premier, FaceIT)."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="winRateGameType" id="statToggle-winRateGameType">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-overtimeGames">Overtime Games</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The number and percentage of your matches that went into overtime."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="overtimeGames" id="statToggle-overtimeGames">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-otWinLoss">OT Wins / Losses</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="How many of your overtime matches you won versus lost."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="otWinLoss" id="statToggle-otWinLoss">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-avgScoreMargin">Avg Score Margin</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The average difference between your score and your opponent's score across all matches."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="avgScoreMargin" id="statToggle-avgScoreMargin">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-currentStreak">Current Streak</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="Your current consecutive run of wins or losses, based on your most recently added match."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="currentStreak" id="statToggle-currentStreak">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-bestMap">Best Map</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The map you have the highest win rate on."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="bestMap" id="statToggle-bestMap">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-worstMap">Worst Map</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The map you have the lowest win rate on."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="worstMap" id="statToggle-worstMap">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-bestMapCT">Best Map (CT Start)</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The map you have the highest win rate on when starting CT."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="bestMapCT" id="statToggle-bestMapCT">
                        </div>
                    </div>

                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statToggle-bestMapT">Best Map (T Start)</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="The map you have the highest win rate on when starting T."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-toggle" type="checkbox" data-stat-key="bestMapT" id="statToggle-bestMapT">
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <p class="small-muted mb-3">Choose which matches count toward the stats above.</p>

                <div class="csm-toggle-grid">
                    <div class="csm-toggle-cell">
                        <div class="csm-toggle-cell-head">
                            <label for="statFilter-activeDutyOnly">Active Duty maps only</label>
                            <i class="fa-solid fa-circle-info" data-bs-toggle="tooltip" title="Only count matches played on a map currently in the competitive Active Duty pool (managed in Settings)."></i>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input js-stat-filter-toggle" type="checkbox" data-filter-key="activeDutyOnly" id="statFilter-activeDutyOnly">
