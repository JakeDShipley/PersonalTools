@page
@model PersonalTools.Pages.CSMatches.IndexModel
@{
    ViewData["Title"] = "CS2 Matches";

    // Mirrors the initials() fallback the CS2 Player Stats page uses for its tab avatars.
    string Initials(string name) => string.Join(string.Empty, (string.IsNullOrWhiteSpace(name) ? "CS" : name)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(word => char.ToUpperInvariant(word[0])));
}

@section Head {
    <link rel="stylesheet" href="~/css/cs-matches.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4">
    <div class="csm-page">
        @Html.AntiForgeryToken()
        <div class="row align-items-start gy-3 section-spacing">
            <div class="col-12 col-lg">
                <p class="eyebrow">Counter-Strike 2</p>
                <h1 class="page-title">CS Matches</h1>
                <p class="page-subtitle">
                    Track your CS2 match results and stats.
                </p>
            </div>
        </div>

        @await Html.PartialAsync("_ToolGuide", new[]
        {
            "Add a match manually, or fetch your recent games straight from Leetify.",
            "Track other players too: add a tab with a pasted SteamID64, each with its own matches and stats.",
            "Use Edit Stats to choose which numbers show and which matches count toward them."
        })

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success shadow-sm border-0 section-spacing">
                @Model.SuccessMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger shadow-sm border-0 section-spacing">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.MapPoolSuggestionPending)
        {
            <div class="alert alert-info shadow-sm border-0 section-spacing d-none" id="mapPoolSuggestionBanner">
                <i class="fa-solid fa-circle-info me-1"></i>
                The Active Duty map pool may have changed. <a href="/Settings">Review it in Settings</a>.
            </div>
        }

        @* Profile tabs - mimics the CS2 Player Stats page's nav-tabs treatment. Switching tabs is
           handled entirely client-side (see csMatchesSwitchProfile in the script section below). *@
        <ul class="nav nav-tabs csm-tabs" id="profileTabs" role="tablist">
            <li class="nav-item csm-tab-item">
                <a href="?ProfileId=" class="nav-link @(Model.ActiveProfile == null ? "active" : "")" data-profile-id="" data-profile-name="@Model.YouDisplayName">
                    <span class="csm-tab-avatar">
                        @if (!string.IsNullOrWhiteSpace(Model.YouAvatarUrl))
                        {
                            <img src="@Model.YouAvatarUrl" alt="" class="js-avatar-img" referrerpolicy="no-referrer" />
                        }
                        <span class="js-avatar-fallback @(string.IsNullOrWhiteSpace(Model.YouAvatarUrl) ? "" : "d-none")" aria-hidden="true">@Initials(Model.YouDisplayName)</span>
                    </span>
                    You
                </a>
            </li>

            @foreach (var profile in Model.Profiles)
            {
                bool isActive = Model.ActiveProfile?.ProfileId == profile.ProfileId;

                <li class="nav-item csm-tab-item">
                    <a href="?ProfileId=@profile.ProfileId" class="nav-link @(isActive ? "active" : "")" data-profile-id="@profile.ProfileId" data-profile-name="@profile.Name" data-profile-steamid="@profile.SteamId">
                        <span class="csm-tab-avatar">
                            @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                            {
                                <img src="@profile.AvatarUrl" alt="" class="js-avatar-img" referrerpolicy="no-referrer" />
                            }
                            <span class="js-avatar-fallback @(string.IsNullOrWhiteSpace(profile.AvatarUrl) ? "" : "d-none")" aria-hidden="true">@Initials(profile.Name)</span>
                        </span>
                        @profile.Name
                    </a>
                    <button class="csm-tab-close js-edit-profile @(isActive ? "" : "d-none")"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#editProfileModal"
                            data-profile-id="@profile.ProfileId"
                            data-profile-name="@profile.Name"
                            data-profile-steamid="@profile.SteamId"
                            title="Edit profile"
                            aria-label="Edit profile">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                </li>
            }

            <li class="nav-item csm-tab-item">
                <button class="csm-tab-add" type="button" data-bs-toggle="modal" data-bs-target="#addProfileModal" title="Add profile" aria-label="Add profile">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </li>
        </ul>

        @* Everything below is profile-scoped: the stats panel refreshes via /api/csmatches/stats and
           the match table/cards via page-cs-match-tracker.js on every tab switch. *@
        <div id="csMatchesWorkspace">

        @* Stats panel - the "folder" content the tabs sit on top of. Edit Stats lives in its header
           so it reads as acting on this panel, not as a page-wide action. *@
        <div class="csm-tabs-panel section-spacing">
            <div class="csm-panel-head">
                <p class="csm-panel-head-label">Your stats</p>
                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#editStatsModal">
                    <i class="fa-solid fa-sliders me-1"></i>Edit Stats
                </button>
            </div>
            <div class="csm-stats" id="statsRow">
                <div class="csm-stat js-stat" data-stat-key="totalMatches">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The total number of matches you've logged."></i>
                    <p class="csm-stat-label mb-1">Total Matches</p>
                    <p class="csm-stat-value js-stat-value">@Model.Stats.TotalMatches</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="winsLosses">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="Your total number of match wins versus losses."></i>
                    <p class="csm-stat-label mb-1">Wins / Losses</p>
                    <p class="csm-stat-value js-stat-value"><span class="win">@Model.Stats.Wins</span> / <span class="loss">@Model.Stats.Losses</span></p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="totalWinRate">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The percentage of all logged matches you've won."></i>
                    <p class="csm-stat-label mb-1">Total Win Rate</p>
                    <p class="csm-stat-value js-stat-value">@Model.Stats.WinRate%</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="winRateCT">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="Your win rate in matches where you started on the CT side."></i>
                    <p class="csm-stat-label mb-1">Win Rate (CT Start)</p>
                    <p class="csm-stat-value js-stat-value">@Model.Stats.WinRateCTStart%</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="winRateT">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="Your win rate in matches where you started on the T side."></i>
                    <p class="csm-stat-label mb-1">Win Rate (T Start)</p>
                    <p class="csm-stat-value js-stat-value">@Model.Stats.WinRateTStart%</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="overtimeGames">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The number and percentage of your matches that went into overtime."></i>
                    <p class="csm-stat-label mb-1">Overtime Games</p>
                    <p class="csm-stat-value js-stat-value">@Model.Stats.OvertimeGames (@Model.Stats.OvertimeGamePercentage%)</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="otWinLoss">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="How many of your overtime matches you won versus lost."></i>
                    <p class="csm-stat-label mb-1">OT Wins / Losses</p>
                    <p class="csm-stat-value js-stat-value"><span class="win">@Model.Stats.OvertimeWins</span> / <span class="loss">@Model.Stats.OvertimeLosses</span></p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="avgScoreMargin">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The average difference between your score and your opponent's score across all matches."></i>
                    <p class="csm-stat-label mb-1">Avg Score Margin</p>
                    <p class="csm-stat-value js-stat-value">@Model.Stats.AverageScoreMargin</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="currentStreak">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="Your current consecutive run of wins or losses, based on your most recently added match."></i>
                    <p class="csm-stat-label mb-1">Current Streak</p>
                    <p class="csm-stat-value js-stat-value @(Model.Stats.CurrentStreakType == "Win" ? "win" : "loss")">
                        @(Model.Stats.CurrentStreak > 0 ? $"{Model.Stats.CurrentStreak} {Model.Stats.CurrentStreakType}{(Model.Stats.CurrentStreak > 1 ? "s" : "")}" : "-")
                    </p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="bestMap">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The map you have the highest win rate on."></i>
                    <p class="csm-stat-label mb-1">Best Map</p>
                    <p class="csm-stat-value js-stat-value">@(Model.Stats.BestMap ?? "-") @(Model.Stats.BestMap != null ? $"({Model.Stats.BestMapWinRate}%)" : "")</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="worstMap">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The map you have the lowest win rate on."></i>
                    <p class="csm-stat-label mb-1">Worst Map</p>
                    <p class="csm-stat-value js-stat-value">@(Model.Stats.WorstMap ?? "-") @(Model.Stats.WorstMap != null ? $"({Model.Stats.WorstMapWinRate}%)" : "")</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="bestMapCT">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The map you have the highest win rate on when starting CT."></i>
                    <p class="csm-stat-label mb-1">Best Map (CT Start)</p>
                    <p class="csm-stat-value js-stat-value">@(Model.Stats.BestMapCTStart ?? "-") @(Model.Stats.BestMapCTStart != null ? $"({Model.Stats.BestMapCTStartWinRate}%)" : "")</p>
                </div>

                <div class="csm-stat js-stat" data-stat-key="bestMapT">
                    <i class="fa-solid fa-circle-info csm-stat-info" data-bs-toggle="tooltip" title="The map you have the highest win rate on when starting T."></i>
                    <p class="csm-stat-label mb-1">Best Map (T Start)</p>
                    <p class="csm-stat-value js-stat-value">@(Model.Stats.BestMapTStart ?? "-") @(Model.Stats.BestMapTStart != null ? $"({Model.Stats.BestMapTStartWinRate}%)" : "")</p>
                </div>
            </div>
        </div>

        @* Filters, view toggle, and the primary match actions all live together above the list. *@
        <div class="card shadow-sm border-0 section-spacing">
            <div class="card-body p-3">
                <div class="csm-filters">
                    <div class="csm-filter-field">
                        <label for="filterMap">Map</label>
                        <select class="form-select form-select-sm" id="filterMap">
                            <option value="">All maps</option>
                            @foreach (var map in Model.Maps)
                            {
                                <option value="@map.Name">@map.Name</option>
                            }
                        </select>
                    </div>
                    <div class="csm-filter-field">
                        <label for="filterResult">Result</label>
                        <select class="form-select form-select-sm" id="filterResult">
                            <option value="">All</option>
                            <option value="win">Wins</option>
                            <option value="loss">Losses</option>
                        </select>
                    </div>
                    <div class="csm-filter-field">
                        <label for="filterSide">Start Side</label>
                        <select class="form-select form-select-sm" id="filterSide">
                            <option value="">All</option>
                            <option value="CT">CT</option>
                            <option value="T">T</option>
                        </select>
                    </div>
                    <div class="csm-filter-field">
                        <label for="filterOvertime">Overtime</label>
                        <select class="form-select form-select-sm" id="filterOvertime">
                            <option value="">All</option>
                            <option value="yes">Overtime only</option>
                            <option value="no">Regulation only</option>
                        </select>
                    </div>

                    <div class="csm-view-toggle" role="group" aria-label="Match view">
                        <button type="button" class="js-view-toggle" data-view="list" title="List view"><i class="fa-solid fa-list"></i></button>
                        <button type="button" class="js-view-toggle" data-view="cards" title="Card view"><i class="fa-solid fa-table-cells-large"></i></button>
                    </div>

                    <div class="csm-filters-actions">
                        <button class="btn btn-outline-danger" type="button" id="deleteAllMatchesBtn" data-bs-toggle="modal" data-bs-target="#deleteAllMatchesModal" title="Delete all matches" aria-label="Delete all matches" @(Model.Stats.TotalMatches == 0 ? "disabled" : "")>
                            <i class="fa-solid fa-trash"></i>
                        </button>
                        <button class="btn btn-outline-secondary" type="button" id="fetchLeetifyBtn" data-steam-linked="@Model.HasLinkedSteamId.ToString().ToLowerInvariant()">
                            <i class="fa-solid fa-cloud-arrow-down me-1"></i>Fetch from Leetify
                        </button>
                        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addMatchModal">
                            <i class="fa-solid fa-plus me-1"></i>Add match
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* Match list (Bootstrap table) / cards - rows are rendered entirely by page-cs-match-tracker.js;
           this markup only supplies the table structure/headers and the empty body/card targets. *@
        <div class="table-responsive csm-table-wrap" id="csMatchTableWrap">
            <table class="table csm-match-table" id="csMatchTable">
                <thead>
                    <tr>
                        <th>Map</th>
                        <th>Type</th>
                        <th>Side</th>
                        <th>Score</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="csMatchTableBody"></tbody>
            </table>
        </div>

        <div class="csm-matches-cards d-none" id="matchCardView"></div>

        <div class="csm-table-footer d-none" id="csMatchPaginationBar">
            <div class="csm-page-size">
                <label for="csMatchPageSize">Rows per page</label>
                <select id="csMatchPageSize" class="form-select form-select-sm">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="csm-page-nav">
                <span class="csm-page-summary" id="csMatchPageSummary"></span>
                <nav aria-label="Match pagination">
                    <ul class="pagination pagination-sm mb-0" id="csMatchPagination"></ul>
                </nav>
            </div>
        </div>

        <div class="csm-empty d-none" id="csMatchEmptyAll">
            No matches yet. Click <strong>Add match</strong> to record your first one.
        </div>
        <div class="csm-empty d-none" id="csMatchEmptyFiltered">
            No matches found for the selected filters.
        </div>

        </div>
    </div>
</div>

@* Add Match Modal *@
<div class="modal fade" id="addMatchModal" tabindex="-1" aria-labelledby="addMatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="addMatchForm" class="js-match-form">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="addMatchModalLabel">Add match</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="csm-form-grid">
                        <div class="csm-form-field">
                            <label>Start Side</label>
                            <div class="csm-side-toggle">
                                <button type="button" class="csm-side-toggle-btn active js-side-toggle" data-side-target="addStartSide" data-side-value="CT">
                                    <img src="/images/cs/teams/ct.png" alt="" />CT
                                </button>
                                <button type="button" class="csm-side-toggle-btn js-side-toggle" data-side-target="addStartSide" data-side-value="T">
                                    <img src="/images/cs/teams/t.png" alt="" />T
                                </button>
                            </div>
                        </div>

                        <div class="csm-form-field">
                            <label>Game Type</label>
                            <select id="addGameType" class="form-select js-game-type-select">
                                @foreach (var gt in Model.GameTypes)
                                {
                                    <option value="@gt">@gt</option>
                                }
                            </select>
                        </div>

                        <div class="csm-form-field full">
                            <label>Map</label>
                            <div class="csm-map-preview">
                                <img src="" id="addMapPreview" class="js-map-preview" style="display: none;" alt="Map preview" />
                                <select id="addMapName" class="form-select js-map-select" data-preview-target="addMapPreview" style="flex:1;">
                                    @foreach (var map in Model.Maps)
                                    {
                                        <option value="@map.Name" data-image="@map.ImagePath">@map.Name</option>
                                    }
                                </select>
                                <button class="btn btn-outline-secondary text-nowrap js-open-add-map" type="button" data-bs-toggle="modal" data-bs-target="#addMapModal">
                                    <i class="fa-solid fa-plus me-1"></i>New Map
                                </button>
                            </div>
                        </div>

                        <div class="csm-form-field">
                            <label>Your Team Score</label>
                            <input type="number" min="0" id="addTeamScore" class="form-control js-team-score" placeholder="e.g. 13" />
                        </div>

                        <div class="csm-form-field">
                            <label>Opponent Score</label>
                            <input type="number" min="0" id="addOpponentScore" class="form-control js-opponent-score" placeholder="e.g. 7" />
                        </div>

                        <div class="csm-form-field full js-ot-wrapper" id="addOtWrapper" style="display: none;">
                            <label>Overtime detected &mdash; how many overtimes were played?</label>
                            <input type="number" min="1" id="addOvertimeCount" class="form-control js-ot-count" style="max-width: 10rem;" />
                        </div>

                        <div class="csm-form-field full js-score-warning d-none">
                            <div class="alert alert-warning mb-0">
                                This score isn't possible in CS2 &mdash; the losing team would need to have reached at least the previous overtime's tie score for the winning team's score to be this high. Double-check the score before saving.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save match</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Edit Match Modal *@
<div class="modal fade" id="editMatchModal" tabindex="-1" aria-labelledby="editMatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="editMatchForm" class="js-match-form">
                <input type="hidden" id="editMatchId" />

                <div class="modal-header">
                    <h2 class="modal-title h5" id="editMatchModalLabel">Edit match</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="csm-form-grid">
                        <div class="csm-form-field">
                            <label>Start Side</label>
                            <div class="csm-side-toggle">
                                <button type="button" class="csm-side-toggle-btn active js-side-toggle" data-side-target="editStartSide" data-side-value="CT">
                                    <img src="/images/cs/teams/ct.png" alt="" />CT
                                </button>
                                <button type="button" class="csm-side-toggle-btn js-side-toggle" data-side-target="editStartSide" data-side-value="T">
                                    <img src="/images/cs/teams/t.png" alt="" />T
                                </button>
                            </div>
                            <input type="hidden" id="editStartSide" value="CT" />
                        </div>

                        <div class="csm-form-field">
                            <label>Game Type</label>
                            <select id="editGameType" class="form-select js-game-type-select">
                                @foreach (var gt in Model.GameTypes)
                                {
                                    <option value="@gt">@gt</option>
                                }
                            </select>
                        </div>

                        <div class="csm-form-field full">
                            <label>Map</label>
                            <div class="csm-map-preview">
                                <img src="" id="editMapPreview" class="js-map-preview" style="display: none;" alt="Map preview" />
                                <select id="editMapName" class="form-select js-map-select" data-preview-target="editMapPreview" style="flex:1;">
                                    @foreach (var map in Model.Maps)
                                    {
                                        <option value="@map.Name" data-image="@map.ImagePath">@map.Name</option>
                                    }
                                </select>
                                <button class="btn btn-outline-secondary text-nowrap js-open-add-map" type="button" data-bs-toggle="modal" data-bs-target="#addMapModal">
                                    <i class="fa-solid fa-plus me-1"></i>New Map
                                </button>
                            </div>
                        </div>

                        <div class="csm-form-field">
                            <label>Your Team Score</label>
                            <input type="number" min="0" id="editTeamScore" class="form-control js-team-score" />
                        </div>

                        <div class="csm-form-field">
                            <label>Opponent Score</label>
                            <input type="number" min="0" id="editOpponentScore" class="form-control js-opponent-score" />
                        </div>

                        <div class="csm-form-field full js-ot-wrapper" id="editOtWrapper" style="display: none;">
                            <label>Overtime detected &mdash; how many overtimes were played?</label>
                            <input type="number" min="1" id="editOvertimeCount" class="form-control js-ot-count" style="max-width: 10rem;" />
                        </div>

                        <div class="csm-form-field full js-score-warning d-none">
                            <div class="alert alert-warning mb-0">
                                This score isn't possible in CS2 &mdash; the losing team would need to have reached at least the previous overtime's tie score for the winning team's score to be this high. Double-check the score before saving.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Delete Match Modal *@
<div class="modal fade" id="deleteMatchModal" tabindex="-1" aria-labelledby="deleteMatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form>
                <input type="hidden" id="deleteMatchId" />

                <div class="modal-header">
                    <h2 class="modal-title h5" id="deleteMatchModalLabel">Delete match</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-1">Are you sure you want to delete this match?</p>
                    <p class="fw-semibold mb-0" id="deleteMatchTitle"></p>
                    <p class="small-muted mt-3 mb-0">This action cannot be undone.</p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger" type="submit">Delete match</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Delete All Matches Modal *@
<div class="modal fade" id="deleteAllMatchesModal" tabindex="-1" aria-labelledby="deleteAllMatchesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteAllMatchesModalLabel">Delete all matches</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="mb-3">
                    This will permanently delete every match you've logged. This action cannot be undone.
                </p>

                <form id="deleteAllMatchesForm">
                    <button type="button" class="btn btn-outline-danger w-100 position-relative overflow-hidden hold-delete-btn" data-hold-form="deleteAllMatchesForm" data-hold-modal="deleteAllMatchesModal" data-hold-duration-ms="2000">
                        <span class="hold-delete-fill"></span>
                        <span class="hold-delete-label position-relative">Hold to delete all matches</span>
                    </button>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

@* Add Profile Modal *@
<div class="modal fade" id="addProfileModal" tabindex="-1" aria-labelledby="addProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="CreateProfile">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="addProfileModalLabel">Add profile</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input asp-for="ProfileName" id="addProfileName" class="form-control" placeholder="e.g. Ragnar" maxlength="100" required />
                    </div>

                    <div class="js-steam-lookup mb-0" data-name-target="#addProfileName">
                        <label class="form-label">SteamID64</label>
                        <div class="input-group">
                            <input asp-for="ProfileSteamId" id="addProfileSteamId" class="form-control js-steam-lookup-input" placeholder="SteamID64, profile URL, custom URL, or name" pattern="^7656\d{13}$" required />
                            <button class="btn btn-outline-secondary js-steam-lookup-btn" type="button" title="Look up this Steam profile"><i class="fa-solid fa-magnifying-glass"></i></button>
                        </div>
                        <div class="js-steam-lookup-result d-none mt-2 small"></div>
                        <div class="form-text">Enter a SteamID64 directly, or a profile URL/name and search to look it up.</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Add profile</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Edit Profile Modal *@
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="UpdateProfile">
                <input type="hidden" asp-for="ProfileId" id="editProfileId" />

                <div class="modal-header">
                    <h2 class="modal-title h5" id="editProfileModalLabel">Edit profile</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input asp-for="ProfileName" id="editProfileName" class="form-control" maxlength="100" required />
                    </div>

                    <div class="js-steam-lookup mb-0" data-name-target="#editProfileName">
                        <label class="form-label">SteamID64</label>
                        <div class="input-group">
                            <input asp-for="ProfileSteamId" id="editProfileSteamId" class="form-control js-steam-lookup-input" pattern="^7656\d{13}$" required />
                            <button class="btn btn-outline-secondary js-steam-lookup-btn" type="button" title="Look up this Steam profile"><i class="fa-solid fa-magnifying-glass"></i></button>
                        </div>
                        <div class="js-steam-lookup-result d-none mt-2 small"></div>
                        <div class="form-text">Enter a SteamID64 directly, or a profile URL/name and search to look it up.</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-outline-danger me-auto" type="button" data-bs-toggle="modal" data-bs-target="#deleteProfileModal">Remove profile</button>
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Delete Profile Modal *@
<div class="modal fade" id="deleteProfileModal" tabindex="-1" aria-labelledby="deleteProfileModalLabel" aria-hidden="true">
