@page
@model PersonalTools.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Account";
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-account.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4 account-page">
    <header class="section-spacing">
        <p class="eyebrow">Personal Tools</p>
        <h1 class="page-title">Your account</h1>
        <p class="page-subtitle">Review your account identity and keep your sign-in secure.</p>
    </header>

    <div class="row g-4 align-items-start">
        <div class="col-12 col-xl-5">
            <section class="card border-0 shadow-sm account-summary-card" aria-labelledby="accountSummaryTitle">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <span class="account-avatar" aria-hidden="true">@Model.Initials</span>
                        <div class="min-w-0">
                            <p class="eyebrow mb-1">Signed in as</p>
                            <h2 class="h4 fw-semibold mb-0 text-truncate" id="accountSummaryTitle">@Model.DisplayName</h2>
                        </div>
                    </div>

                    <dl class="account-details mb-0">
                        <div>
                            <dt><i class="fa-regular fa-envelope" aria-hidden="true"></i> Email</dt>
                            <dd>@Model.Email</dd>
                        </div>
                        <div>
                            <dt><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Password storage</dt>
                            <dd>Salted one-way hashing</dd>
                        </div>
                        <div>
                            <dt><i class="fa-solid fa-user-lock" aria-hidden="true"></i> Account data</dt>
                            <dd>Scoped to your user</dd>
                        </div>
                    </dl>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-7">
            <section class="card border-0 shadow-sm" aria-labelledby="changePasswordTitle">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-start gap-3 mb-4">
                        <span class="account-section-icon" aria-hidden="true"><i class="fa-solid fa-key"></i></span>
                        <div>
                            <h2 class="h4 fw-semibold mb-1" id="changePasswordTitle">Change password</h2>
                            <p class="small-muted mb-0">Confirm your current password before choosing a new one.</p>
                        </div>
                    </div>

                    <form id="changePasswordForm" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label" for="currentPassword">Current password</label>
                            <div class="input-group password-input-group">
                                <input class="form-control" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" autocapitalize="none" spellcheck="false" maxlength="256" required />
                                <button class="btn btn-outline-secondary password-visibility-toggle" type="button" data-password-toggle="currentPassword" aria-label="Show current password" title="Show password">
                                    <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="newPassword">New password</label>
                                <div class="input-group password-input-group">
                                    <input class="form-control" id="newPassword" name="newPassword" type="password" autocomplete="new-password" autocapitalize="none" spellcheck="false" minlength="12" maxlength="128" required aria-describedby="passwordRequirements" />
                                    <button class="btn btn-outline-secondary password-visibility-toggle" type="button" data-password-toggle="newPassword" aria-label="Show new password" title="Show password">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="confirmPassword">Confirm new password</label>
                                <div class="input-group password-input-group">
                                    <input class="form-control" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" autocapitalize="none" spellcheck="false" minlength="12" maxlength="128" required />
                                    <button class="btn btn-outline-secondary password-visibility-toggle" type="button" data-password-toggle="confirmPassword" aria-label="Show confirmed password" title="Show password">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="account-password-guidance my-4" id="passwordRequirements">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                            <span>Use 12–128 characters with uppercase, lowercase, a number and a symbol. Other signed-in sessions will be ended.</span>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                            <button class="btn btn-outline-secondary" id="resetPasswordForm" type="button">Clear</button>
                            <button class="btn btn-primary px-4" type="submit">
                                <i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>Change password
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/page-account.js" asp-append-version="true"></script>
}
