@page
@model PersonalTools.Pages.CaseOpening.IndexModel
@using PersonalTools.Security
@{
    ViewData["Title"] = "CS2 Case Simulator";
    bool canManageCaseOpening = User.IsUserAllowedHere(AppRole.Admin);
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-case-opening.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4 case-opening-page" data-case-key="kilowatt">
    @Html.AntiForgeryToken()

    <div class="row align-items-end gy-3 section-spacing">
        <div class="col-12 col-lg">
            <p class="eyebrow">Counter-Strike 2 simulator</p>
            <h1 class="page-title">Case opening</h1>
            <p class="page-subtitle">Open a curated selection of iconic CS cases and capsules without money or real inventory items.</p>
        </div>
        <div class="col-12 col-lg-auto">
            <span class="badge text-bg-warning case-simulation-badge"><i class="fa-solid fa-flask me-2"></i>Simulation only</span>
        </div>
    </div>

    @await Html.PartialAsync("_ToolGuide", new[]
    {
        "Press Open case and the server securely selects an item using the displayed rarity odds.",
        "Watch the reel settle on your result; simulated items have no cash value and are not added to Steam.",
        "Your results are saved privately below. Select unwanted items and sell them for Stars, or turn them into stronger skins through Trade Up Contracts."
    })

    <div class="case-dock-row">
        <aside class="case-stars-dock shadow-sm" aria-label="Case-opening Stars balance" aria-live="polite">
            <span class="case-stars-icon"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
            <strong id="caseStarsBalance" aria-live="polite">0</strong>
        </aside>
        @if (canManageCaseOpening)
        {
            <button class="case-tweak-button shadow-sm" id="caseTweakButton" type="button" data-bs-toggle="modal" data-bs-target="#caseTweakModal" aria-label="Open variable tweak modal" title="Tweak variables (testing)">
                <i class="fa-solid fa-wrench" aria-hidden="true"></i>
            </button>
        }
    </div>

    <div class="case-xp-bar section-spacing" id="caseXpBar" aria-live="polite">
        <div class="case-xp-bar-head">
            <span class="case-xp-level-badge" id="caseXpLevelBadge">Lv 0</span>
            <span class="case-xp-text" id="caseXpText">0 / 100 XP</span>
        </div>
        <div class="case-xp-track" role="progressbar" aria-label="Level progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="caseXpTrack">
            <span class="case-xp-fill" id="caseXpFill"></span>
        </div>

        <div class="case-level-up-toast d-none" id="caseLevelUpToast" aria-live="polite" aria-atomic="true">
            <span class="case-level-up-burst" aria-hidden="true"></span>
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <div>
                <p>Level up!</p>
                <strong id="caseLevelUpText">Level 1</strong>
            </div>
        </div>
    </div>

    <section class="card border-0 shadow-sm case-achievements section-spacing" id="caseAchievements" data-case-destination-panel="open" aria-labelledby="caseAchievementsTitle">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <p class="eyebrow mb-1">Player progression</p>
                    <h2 class="h4 mb-1" id="caseAchievementsTitle">Achievements</h2>
                    <p class="small-muted mb-0">Permanent goals, earned Stars and collection milestones for your simulator account.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="case-achievement-count" id="caseAchievementCount">0 / 0</span>
                    <button class="btn btn-outline-secondary btn-sm case-collapse-toggle" type="button" data-case-collapse-toggle="achievements" data-case-collapse-target="#caseAchievementsContent" aria-controls="caseAchievementsContent" aria-expanded="false">
                        <i class="fa-solid fa-chevron-down me-1" aria-hidden="true"></i><span>Show achievements</span>
                    </button>
                </div>
            </div>

            <div class="row g-2 case-achievement-stats" id="caseAchievementStats" aria-live="polite">
                <div class="col-6 col-md-3"><div class="case-achievement-stat"><span>Cases opened</span><strong id="caseAchievementCases">0</strong></div></div>
                <div class="col-6 col-md-3"><div class="case-achievement-stat"><span>Trade Ups</span><strong id="caseAchievementTradeUps">0</strong></div></div>
                <div class="col-6 col-md-3"><div class="case-achievement-stat"><span>Login streak</span><strong id="caseAchievementStreak">0 days</strong></div></div>
                <div class="col-6 col-md-3"><div class="case-achievement-stat"><span>Reward Stars</span><strong id="caseAchievementStars">0</strong></div></div>
            </div>

            <div class="collapse" id="caseAchievementsContent" data-case-collapse-default="closed">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4 mb-3">
                    <p class="small-muted mb-0">Achievement rewards are applied securely by the server and only once per account.</p>
                    <span class="badge text-bg-secondary-subtle border" id="caseAchievementCollections">0 collections · 0 rarity sets</span>
                </div>
                <div class="row g-2" id="caseAchievementGrid" aria-live="polite"></div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm case-shop section-spacing d-none" id="caseShop" data-case-destination-panel="shop" aria-labelledby="caseShopTitle">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <p class="eyebrow mb-1">Simulator marketplace</p>
                    <h2 class="h4 mb-1" id="caseShopTitle">Shop</h2>
                    <p class="small-muted mb-0">Unlock a case once, then spend Stars on copies whenever you want to open it.</p>
                </div>
                <span class="case-shop-stars"><i class="fa-solid fa-star" aria-hidden="true"></i><strong id="caseShopStarsBalance">0</strong> Stars</span>
            </div>

            <div class="case-shop-controls row g-2 align-items-end mb-3">
                <div class="col-12 col-md">
                    <label class="form-label small fw-semibold mb-1" for="caseShopSearch">Find a case or capsule</label>
                    <input class="form-control" id="caseShopSearch" type="search" placeholder="Search the catalogue" autocomplete="off" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold mb-1" for="caseShopTier">Tier</label>
                    <select class="form-select" id="caseShopTier"><option value="">All tiers</option></select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold mb-1" for="caseShopPageSize">Show</label>
                    <select class="form-select" id="caseShopPageSize"><option value="12">12</option><option value="24">24</option><option value="48">48</option></select>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="case-shop-group-toggle h-100 d-flex align-items-center px-3">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input pt-switch" id="caseShopGroupByLevel" type="checkbox" role="switch" checked />
                            <label class="form-check-label small fw-semibold" for="caseShopGroupByLevel">Group by level</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                <span class="small-muted" id="caseShopResultCount">0 cases</span>
                <span class="small-muted">Permanent unlocks · repeatable stock</span>
            </div>
            <div class="row g-2" id="caseShopCaseGrid" aria-live="polite"></div>
            <nav class="mt-3" aria-label="Case shop pages"><ul class="pagination pagination-sm justify-content-center mb-0" id="caseShopPagination"></ul></nav>
        </div>
    </section>

    <section class="card border-0 shadow-sm case-upgrades-store section-spacing d-none" id="caseUpgradeStore" data-case-destination-panel="upgrades" aria-labelledby="caseUpgradeStoreTitle">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <p class="eyebrow mb-1">Simulator progression</p>
                    <h2 class="h4 mb-1" id="caseUpgradeStoreTitle">Upgrades</h2>
                    <p class="small-muted mb-0">Improve your workshop, inventory and opening options with permanent Star upgrades.</p>
                </div>
                <span class="case-shop-stars"><i class="fa-solid fa-star" aria-hidden="true"></i><strong id="caseUpgradeStarsBalance">0</strong> Stars</span>
            </div>
            <div class="case-upgrade-section-heading mb-3">
                <span class="case-shop-icon"><i class="fa-solid fa-server" aria-hidden="true"></i></span>
                <div><p class="eyebrow mb-1">Workshop capacity</p><h3 class="h5 mb-1">Storage and automation</h3><p class="small-muted mb-0">Expand your inventory and build bot capacity for background openings.</p></div>
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <article class="case-shop-storage" id="caseShopStorageCard">
                        <div>
                            <span class="case-shop-icon"><i class="fa-solid fa-box-archive" aria-hidden="true"></i></span>
                            <h3 class="h5 mb-1">Storage container</h3>
                            <p class="small-muted mb-0" id="caseShopStorageCopy">Adds 1,000 permanent inventory slots.</p>
                        </div>
                        <div class="text-lg-end">
                            <strong id="caseShopStorageStatus">0 / 0 owned</strong>
                            <span class="case-upgrade-card-metric d-block mt-1" id="caseShopStorageCapacity">1,000 slots · 0 used</span>
                            <button class="btn btn-warning btn-sm d-block ms-lg-auto mt-2" id="purchaseStorageContainer" type="button">Buy storage</button>
                        </div>
                    </article>
                </div>
                <div class="col-12"><div class="row g-2">
                    <div class="col-12 col-md-6"><article class="case-shop-row"><div><h3 class="h6 mb-1">Bot server</h3><p class="small-muted mb-0">Adds four bot bays to your workshop.</p></div><div class="case-upgrade-card-action"><span class="case-upgrade-card-metric" id="caseUpgradeServerOwnership">0 servers</span><button class="btn btn-outline-warning btn-sm js-shop-buy-server" type="button">Buy server</button></div></article></div>
                    <div class="col-12 col-md-6"><article class="case-shop-row"><div><h3 class="h6 mb-1">Opening bot</h3><p class="small-muted mb-0">Opens an owned case while the page is active.</p></div><div class="case-upgrade-card-action"><span class="case-upgrade-card-metric" id="caseUpgradeBotOwnership">0/0 bots</span><button class="btn btn-outline-warning btn-sm js-shop-buy-bot" type="button">Buy bot</button></div></article></div>
                </div></div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3"><span class="case-shop-icon"><i class="fa-solid fa-warehouse" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Permanent capacity</p><h3 class="h5 mb-1">Workshop shelving</h3><p class="small-muted mb-0">Cases and skins both use one inventory slot. Add permanent shelving as your collection and case stock grow.</p></div></div>
                    <div class="row g-3" id="caseCapacityUpgradeGrid"></div>
                    <p class="case-upgrade-card-metric mt-2 mb-0" id="caseCapacityUpgradeStatus">0 bonus slots unlocked</p>
                </div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3"><span class="case-shop-icon"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Opening controls</p><h3 class="h5 mb-1">Opening quality of life</h3><p class="small-muted mb-0">Make repeat openings quicker and expand the number of cases opened together.</p></div></div>
                    <div class="row g-2" id="caseShopUpgradeGrid"></div>
                </div>
                <div class="col-12">
                    <div class="case-upgrade-section-heading mt-2 mb-3"><span class="case-shop-icon"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Inventory throughput</p><h3 class="h5 mb-1">Bulk selling</h3><p class="small-muted mb-0">Bulk sales start at 100 items regardless of the visible page. Upgrade the secure server-side limit as your inventory grows.</p></div></div>
                    <div class="row g-3" id="caseInventoryUpgradeGrid"></div>
                    <div class="case-auto-sell-panel mt-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3"><div><p class="eyebrow mb-1">Automatic selling</p><h3 class="h6 mb-1">Rarity control deck</h3><p class="small-muted mb-0">Enabled rarities are sold immediately after each opening. Common tiers cost more because they create the strongest passive Star income.</p></div><div class="case-preserve-stattrak-control" id="casePreserveStatTrakControl"><div class="form-check form-switch m-0"><input class="form-check-input pt-switch" id="casePreserveStatTrak" type="checkbox" checked disabled /><label class="form-check-label small fw-semibold" for="casePreserveStatTrak">Always keep StatTrak™</label></div><small id="casePreserveStatTrakHint">Unlock an auto-sell tier first</small></div></div>
                        <div class="case-auto-sell-grid" id="caseAutoSellControls"></div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="case-auto-sell-panel mt-3" id="caseAutoBuyPanel">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <div>
                                <p class="eyebrow mb-1">Automatic restocking</p>
                                <h3 class="h6 mb-1">Auto-buy</h3>
                                <p class="small-muted mb-0" id="caseAutoBuyUpgradeDescription">Automatically repurchase cases when your owned stock runs low.</p>
                            </div>
                            <button class="btn btn-outline-warning btn-sm js-unlock-inventory-upgrade d-none" type="button" id="caseAutoBuyUpgradeButton"></button>
                        </div>
                        <div id="caseAutoBuyRuleEditor" class="d-none">
                            <p class="small-muted mb-2" id="caseAutoBuyPanelCopy">Set a threshold and quantity per case - when your owned stock drops below it, the Shop buys more for you.</p>
                            <div class="case-auto-buy-add-row d-none" id="caseAutoBuyAddRow">
                                <select class="form-select form-select-sm" id="caseAutoBuyAddCase"></select>
                                <label class="case-auto-buy-row-field"><span>Below</span><input class="form-control form-control-sm" type="number" min="0" step="1" id="caseAutoBuyAddThreshold" value="5" /></label>
                                <label class="case-auto-buy-row-field"><span>Buy</span><input class="form-control form-control-sm" type="number" min="1" step="1" id="caseAutoBuyAddQuantity" value="10" /></label>
                                <button class="btn btn-warning btn-sm" type="button" id="caseAutoBuyAddButton">Add rule</button>
                            </div>
                            <div class="d-flex justify-content-end mb-2"><span class="case-upgrade-card-metric" id="caseAutoBuyRuleStatus"></span></div>
                            <div class="case-auto-buy-grid" id="caseAutoBuyRules"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm case-stage section-spacing" data-case-destination-panel="open" aria-labelledby="caseName">
        <canvas class="case-effects-canvas" id="caseEffectsCanvas" aria-hidden="true"></canvas>
        <div class="case-gold-reveal d-none" id="caseGoldReveal" aria-live="polite" aria-atomic="true">
            <span class="case-gold-ring case-gold-ring-one" aria-hidden="true"></span>
            <span class="case-gold-ring case-gold-ring-two" aria-hidden="true"></span>
            <span class="case-gold-slash" aria-hidden="true"></span>
            <div class="case-gold-content">
                <p>Rare special item</p>
                <img id="caseGoldRevealImage" alt="" />
                <h3 id="caseGoldRevealName"></h3>
                <span id="caseGoldRevealMeta"></span>
            </div>
        </div>
        <div class="card-body p-3 p-lg-4 p-xl-5">
            <div class="case-stage-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <p class="eyebrow mb-1" id="caseType">Weapon Case</p>
                    <h2 class="h3 fw-semibold mb-0" id="caseName">Kilowatt Case</h2>
                    <span class="case-owned-count is-empty" id="caseOwnedQuantity" aria-live="polite" aria-atomic="true">
                        <span class="case-owned-count-icon" aria-hidden="true"><i class="fa-solid fa-box"></i></span>
                        <span class="case-owned-count-copy">
                            <small>Cases ready</small>
                            <strong id="caseOwnedQuantityValue">0</strong>
                        </span>
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm" id="caseSoundMenuButton" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Case opening sound settings">
                            <i class="fa-solid fa-volume-high me-1" id="caseSoundButtonIcon" aria-hidden="true"></i><span id="caseSoundButtonText">Sound</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end case-sound-menu p-3" aria-labelledby="caseSoundMenuButton">
                            <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                <div>
                                    <p class="fw-semibold mb-1">Opening sound</p>
                                    <p class="small-muted mb-0" id="caseSoundStatus">Sound is on</p>
                                </div>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input pt-switch" id="caseSoundEnabled" type="checkbox" role="switch" checked />
                                    <label class="visually-hidden" for="caseSoundEnabled">Enable case opening sounds</label>
                                </div>
                            </div>
                            <label class="form-label small fw-semibold" for="caseSoundVolume">Volume</label>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-volume-low small-muted" aria-hidden="true"></i>
                                <input class="form-range case-sound-range" id="caseSoundVolume" type="range" min="0" max="100" step="1" value="45" />
                                <output class="small fw-semibold case-sound-output" id="caseSoundVolumeValue" for="caseSoundVolume">45%</output>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-outline-warning btn-sm" id="caseRareItemsButton" type="button" data-bs-toggle="modal" data-bs-target="#caseRareItemsModal" disabled>
                        <i class="fa-solid fa-gem me-1"></i>Rare items
                    </button>
                    <button class="btn btn-outline-primary btn-sm" id="chooseCaseButton" type="button" data-bs-toggle="modal" data-bs-target="#caseSelectorModal">
                        <i class="fa-solid fa-boxes-stacked me-1"></i>Choose case
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" id="caseOddsButton" type="button" data-bs-toggle="popover" data-bs-placement="bottom" data-bs-html="true" title="Case rarity odds">
                        <i class="fa-solid fa-circle-info me-1"></i>View odds
                    </button>
                </div>
            </div>

            <div class="case-machine">
                <div class="case-reel-window" id="caseReelWindow">
                    <span class="case-reel-marker case-reel-marker-top" aria-hidden="true"></span>
                    <span class="case-reel-marker case-reel-marker-bottom" aria-hidden="true"></span>
                    <div class="case-reel" id="caseReel" aria-live="off"></div>
                    <div class="case-reel-idle" id="caseReelIdle">
                        <img id="caseImage" alt="Kilowatt Case" />
                        <span>Ready to open</span>
                    </div>
                    <div class="d-none" id="caseMultiResults" aria-live="polite"></div>
                </div>

                <div class="case-result-slot" aria-live="polite">
                    <div class="case-result d-none" id="caseResult">
                        <p class="eyebrow mb-1">Unboxed</p>
                        <h3 class="h4 mb-1" id="caseResultName"></h3>
                        <p class="small-muted mb-0" id="caseResultMeta"></p>
                    </div>
                </div>

                <div class="case-open-controls mt-4">
                    <button class="btn btn-warning btn-lg case-open-button" id="openCaseButton" type="button" disabled>
                        <i class="fa-solid fa-box-open me-2"></i>Open case
                    </button>
                    <div class="btn-group btn-group-sm case-open-quantity d-none" id="caseOpenQuantity" role="group" aria-label="Number of cases to open">
                        <button class="btn btn-outline-warning active" type="button" data-open-quantity="1" aria-pressed="true">1</button>
                        <button class="btn btn-outline-warning" type="button" data-open-quantity="2" aria-pressed="false">2</button>
                        <button class="btn btn-outline-warning" type="button" data-open-quantity="3" aria-pressed="false">3</button>
                        <button class="btn btn-outline-warning" type="button" data-open-quantity="4" aria-pressed="false">4</button>
                        <button class="btn btn-outline-warning" type="button" data-open-quantity="5" aria-pressed="false">5</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm case-collection section-spacing" id="caseCollection" data-case-destination-panel="open" aria-labelledby="caseCollectionTitle">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <p class="eyebrow mb-1">Permanent collection</p>
                    <h2 class="h4 mb-1" id="caseCollectionTitle">Case collection</h2>
                    <p class="small-muted mb-0" id="caseCollectionSubtitle">Loading this case's collection…</p>
                </div>
                <div class="text-lg-end">
                    <strong class="case-collection-count" id="caseCollectionCount">0 / 0</strong>
                    <small class="d-block small-muted">unique items collected</small>
                </div>
            </div>

            <div class="case-collection-progress mb-3" role="progressbar" aria-label="Case collection progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <span id="caseCollectionProgress"></span>
            </div>
            <div class="case-collection-rarity-summary mb-3" id="caseCollectionRaritySummary"></div>

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <p class="small-muted mb-0">Your progress remains visible while the item list is closed.</p>
                <button class="btn btn-outline-secondary btn-sm case-collapse-toggle" type="button" data-case-collapse-toggle="collection" data-case-collapse-target="#caseCollectionContent" aria-controls="caseCollectionContent" aria-expanded="false">
                    <i class="fa-solid fa-chevron-down me-1" aria-hidden="true"></i><span>Show items</span>
                </button>
            </div>

            <div class="collapse" id="caseCollectionContent" data-case-collapse-default="closed">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 my-3">
                    <p class="small-muted mb-0">Selling an item does not remove it from your collection.</p>
                    <div class="btn-group btn-group-sm case-collection-filters" role="group" aria-label="Filter collection items">
                        <button class="btn btn-outline-secondary active" type="button" data-collection-filter="all">All</button>
                        <button class="btn btn-outline-secondary" type="button" data-collection-filter="collected">Collected</button>
                        <button class="btn btn-outline-secondary" type="button" data-collection-filter="missing">Missing</button>
                    </div>
                </div>
                <div class="row g-2" id="caseCollectionGrid" aria-live="polite"></div>
                <div class="case-collection-empty text-center py-4 d-none" id="caseCollectionEmpty">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    <p class="mb-0 mt-2">No items match this collection filter.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm case-upgrades section-spacing d-none" id="caseUpgrades" aria-labelledby="caseUpgradesTitle">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <p class="eyebrow mb-1">Stars upgrades</p>
                    <h2 class="h4 mb-1" id="caseUpgradesTitle">Tune your opening flow</h2>
                    <p class="small-muted mb-0">Sell simulated inventory items for Stars, then unlock quality-of-life upgrades permanently for your account.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
