@page
@model PersonalTools.Pages.Admin.Users.IndexModel
@{ ViewData["Title"] = "User management"; }
@section Head { <link rel="stylesheet" href="~/css/pages/page-admin-users.css" asp-append-version="true" /> }

<div class="container px-3 px-lg-4 admin-users-page">
    @Html.AntiForgeryToken()
    <div class="admin-users-hero section-spacing">
        <div><p class="eyebrow mb-1">Administration</p><h1 class="page-title mb-2">User management</h1><p class="page-subtitle mb-0">Manage access, roles and account state from one secure workspace.</p></div>
        <button class="btn btn-primary admin-users-add" type="button" id="addManagedUser"><i class="fa-solid fa-user-plus me-2"></i>Add user</button>
    </div>
    <section class="card app-surface-card admin-users-summary"><div class="card-body p-3 p-lg-4"><div class="row g-3" id="managedUserSummary" aria-live="polite"><div class="col-6 col-lg-3"><div class="admin-users-stat is-loading"><span>Total accounts</span><strong>—</strong></div></div><div class="col-6 col-lg-3"><div class="admin-users-stat is-loading"><span>Active accounts</span><strong>—</strong></div></div><div class="col-6 col-lg-3"><div class="admin-users-stat is-loading"><span>Administrators</span><strong>—</strong></div></div><div class="col-6 col-lg-3"><div class="admin-users-stat is-loading"><span>Recently signed in</span><strong>—</strong></div></div></div></div></section>
    <section class="card app-surface-card admin-users-directory mt-3"><div class="card-body p-3 p-lg-4"><div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3"><div><p class="eyebrow mb-1">Directory</p><h2 class="h5 mb-1">Registered users</h2><p class="small-muted mb-0">Role and status changes are checked again by the server on each request.</p></div><span class="tool-count" id="managedUserCount">Loading…</span></div><div class="row g-2 align-items-center mb-3"><div class="col-12 col-md"><label class="visually-hidden" for="managedUserSearch">Search users</label><div class="input-group"><span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span><input class="form-control" id="managedUserSearch" type="search" placeholder="Search name or email" autocomplete="off" /></div></div><div class="col-6 col-md-auto"><select class="form-select" id="managedUserRoleFilter" aria-label="Filter roles"><option value="">All roles</option><option value="Admin">Admins</option><option value="User">Users</option></select></div><div class="col-6 col-md-auto"><select class="form-select" id="managedUserStatusFilter" aria-label="Filter account status"><option value="">All states</option><option value="active">Active</option><option value="disabled">Disabled</option></select></div></div><div class="table-responsive admin-users-table-wrap"><table class="table align-middle mb-0" id="managedUsersTable"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last sign-in</th><th>Joined</th><th class="text-end">&nbsp;</th></tr></thead><tbody><tr><td colspan="6" class="text-center small-muted py-5">Loading registered users…</td></tr></tbody></table></div><div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3"><div class="small-muted" id="managedUsersResultInfo">Loading results…</div><div class="d-flex align-items-center gap-3"><label class="d-flex align-items-center gap-2 small-muted mb-0">Show <select class="form-select form-select-sm" id="managedUsersPageSize"><option value="10">10</option><option value="25" selected>25</option><option value="50">50</option></select></label><nav aria-label="User management pages"><ul class="pagination pagination-sm mb-0" id="managedUsersPagination"></ul></nav></div></div></div></section>
</div>
<div class="modal fade" id="managedUserModal" tabindex="-1" aria-labelledby="managedUserModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content admin-user-modal"><form id="managedUserForm"><div class="modal-header admin-user-modal-header"><div><p class="eyebrow mb-1">Account access</p><h2 class="modal-title h4 mb-1" id="managedUserModalTitle">Add user</h2><p class="small-muted mb-0" id="managedUserModalCopy">Create a new Personal Tools account.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body p-3 p-lg-4"><input type="hidden" id="managedUserId" /><div class="row g-3"><div class="col-md-6"><label class="form-label" for="managedUserDisplayName">Display name</label><input class="form-control" id="managedUserDisplayName" maxlength="100" required /></div><div class="col-md-6"><label class="form-label" for="managedUserEmail">Email address</label><input class="form-control" id="managedUserEmail" type="email" maxlength="254" required /></div></div><div class="admin-user-modal-panel mt-4"><div class="row g-3 align-items-end"><div class="col-md-7"><label class="form-label" for="managedUserRole">Account role</label><select class="form-select" id="managedUserRole"><option value="1">User - standard tool access</option><option value="2">Admin - full access and account management</option></select></div><div class="col-md-5"><div class="form-check form-switch pt-switch admin-user-active-switch"><input class="form-check-input" type="checkbox" role="switch" id="managedUserActive" checked /><label class="form-check-label" for="managedUserActive"><strong>Account active</strong><small>Disabled accounts cannot sign in.</small></label></div></div></div></div><div class="mt-4"><div class="d-flex align-items-start gap-2 mb-3"><span class="admin-user-modal-section-icon"><i class="fa-solid fa-key"></i></span><div><h3 class="h6 mb-1">Password</h3><p class="small-muted mb-0" id="managedUserPasswordHelp">Set a secure password for this account.</p></div></div><div class="row g-3"><div class="col-md-6"><label class="form-label" for="managedUserPassword">Password</label><div class="input-group"><input class="form-control" type="password" id="managedUserPassword" autocomplete="new-password" /><button class="btn btn-outline-secondary js-password-toggle" type="button" data-target="managedUserPassword" aria-label="Show password"><i class="fa-solid fa-eye"></i></button></div></div><div class="col-md-6"><label class="form-label" for="managedUserConfirmPassword">Confirm password</label><input class="form-control" type="password" id="managedUserConfirmPassword" autocomplete="new-password" /></div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary" id="saveManagedUser"><i class="fa-solid fa-floppy-disk me-2"></i>Save user</button></div></form></div></div></div>
@section Scripts { <script src="~/js/pages/page-admin-users.js" asp-append-version="true"></script> }
