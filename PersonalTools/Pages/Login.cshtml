@page
@model PersonalTools.Pages.LoginModel
@{ ViewData["Title"] = "Sign in"; Layout = "_Layout"; }
@section Head {
    <link rel="stylesheet" href="~/css/pages/page-login.css" asp-append-version="true" />
}
<section class="login-launch-sequence" id="loginLaunchSequence" aria-hidden="true" aria-label="Signing you in">
    <div class="login-launch-content">
        <div class="login-launch-lockup">
            <h2 class="login-launch-wordmark" aria-label="Personal Tools"><span data-launch-word="PERSONAL">PERSONAL</span><span data-launch-word="TOOLS">TOOLS</span></h2>
            <p class="login-launch-greeting" id="loginLaunchGreeting" aria-live="polite"></p>
        </div>
    </div>
</section>
<div class="container px-3 px-lg-4"><div class="row justify-content-center"><div class="col-12 col-sm-9 col-md-7 col-lg-5"><div class="login-card-shell"><div class="card shadow-sm border-0 login-card" id="loginCard"><div class="card-body p-4 p-lg-5"><p class="eyebrow" id="loginEyebrow">Personal Tools</p><h1 class="h3 fw-semibold mb-2 login-splash-title" id="loginSplashTitle" data-final-text="Welcome to Personal Tools">Welcome to Personal Tools</h1><p class="small-muted mb-4" id="loginSubtitle">Sign in to continue to your workspace.</p><div id="loginError" class="alert alert-danger d-none"></div>@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="alert alert-danger">@Model.ErrorMessage</div>}<form method="post" id="loginForm"><input type="hidden" asp-for="ReturnUrl" /><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="email" required /></div><div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required /></div><div class="d-flex justify-content-between align-items-center mb-4"><div class="form-check form-switch"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Remember me</label></div><a asp-page="/ForgotPassword" class="small">Forgot password?</a></div><button class="btn btn-primary w-100" type="submit">Sign in</button></form></div></div></div></div></div>
@section Scripts {
    <script src="~/js/pages/page-login.js" asp-append-version="true"></script>
}
