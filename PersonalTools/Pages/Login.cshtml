@page
@model PersonalTools.Pages.LoginModel
@{ ViewData["Title"] = "Sign in"; Layout = "_Layout"; }
<div class="container px-3 px-lg-4"><div class="row justify-content-center"><div class="col-12 col-sm-9 col-md-7 col-lg-5"><div class="card shadow-sm border-0"><div class="card-body p-4 p-lg-5"><p class="eyebrow">Personal Tools</p><h1 class="h3 fw-semibold mb-2">Welcome back</h1><p class="small-muted mb-4">Sign in to continue to your workspace.</p><div id="loginError" class="alert alert-danger d-none"></div>@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="alert alert-danger">@Model.ErrorMessage</div>}<form method="post" id="loginForm"><input type="hidden" asp-for="ReturnUrl" /><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="email" required /></div><div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required /></div><div class="d-flex justify-content-between align-items-center mb-4"><div class="form-check form-switch"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Remember me</label></div><a asp-page="/ForgotPassword" class="small">Forgot password?</a></div><button class="btn btn-primary w-100" type="submit">Sign in</button></form></div></div></div></div></div>
@section Scripts { <script>$('#loginForm').on('submit',function(e){e.preventDefault();const f=$(this),button=f.find('button'),error=$('#loginError');button.prop('disabled',true).text('Signing in…');$.ajax({url:'/api/auth/login',method:'POST',contentType:'application/json',headers:{RequestVerificationToken:f.find('input[name="__RequestVerificationToken"]').val()},data:JSON.stringify({email:$('#Email').val(),password:$('#Password').val(),rememberMe:$('#RememberMe').is(':checked')})}).done(()=>window.location.href=$('#ReturnUrl').val()||'/').fail(xhr=>{error.text(xhr.responseJSON?.message||'Sign-in failed.').removeClass('d-none')}).always(()=>button.prop('disabled',false).text('Sign in')});</script> }
