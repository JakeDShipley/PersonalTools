@using PersonalTools.Classes.Tracker

@* Shared by the Dashboard's compact Kanban section and the full Tracker page - identical modal
   markup driven by the same wwwroot/js/tracker.js, since a Kanban item can be added/edited from
   either place. *@

<div class="modal fade" id="trackerItemModal" tabindex="-1" aria-labelledby="trackerItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="trackerItemForm">
                <input type="hidden" id="trackerItemId" />

                <div class="modal-header">
                    <h2 class="modal-title h5" id="trackerItemModalLabel">Add tracker item</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <div class="trk-type-toggle">
                            <button type="button" class="trk-type-toggle-btn active bug js-type-toggle" data-type-target="trackerItemType" data-type-value="Bug">
                                <i class="fa-solid fa-bug"></i>&ensp;Bug
                            </button>
                            <button type="button" class="trk-type-toggle-btn feature js-type-toggle" data-type-target="trackerItemType" data-type-value="Feature">
                                <i class="fa-solid fa-star"></i>&ensp;Feature
                            </button>
                        </div>
                        <input type="hidden" id="trackerItemType" value="Bug" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="trackerItemTitle">Title</label>
                        <input id="trackerItemTitle" class="form-control" maxlength="200" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="trackerItemDescription">Description</label>
                        <textarea id="trackerItemDescription" class="form-control" rows="3" maxlength="2000"></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col">
                            <label class="form-label" for="trackerItemArea">Relevant area</label>
                            <select id="trackerItemArea" class="form-select">
                                @foreach (string area in TrackerFuncs.Areas)
                                {
                                    <option value="@area">@area</option>
                                }
                            </select>
                        </div>
                        <div class="col d-none" id="trackerStatusField">
                            <label class="form-label" for="trackerItemStatus">Status</label>
                            <select id="trackerItemStatus" class="form-select">
                                <option value="Open">Open</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Closed">Closed</option>
                                <option value="WontFix">Won't Fix</option>
                            </select>
                            <div class="form-text d-none" id="trackerStatusClosedNote">Closing removes this item from the board immediately.</div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="trackerItemAssignee">Assigned to</label>
                        <select id="trackerItemAssignee" class="form-select">
                            <option value="">None</option>
                        </select>
                    </div>

                    <div class="form-check form-switch trk-dashboard-toggle mt-3">
                        <input class="form-check-input pt-switch" type="checkbox" role="switch" id="trackerItemShowOnDashboard" />
                        <label class="form-check-label" for="trackerItemShowOnDashboard">Show on dashboard mini-view</label>
                    </div>

                    <div id="trackerItemError" class="alert alert-danger d-none mt-3 mb-0"></div>
                </div>

                <div class="modal-footer">
                    <button id="trackerRemoveItemBtn" class="btn btn-outline-danger me-auto d-none" type="button" data-bs-toggle="modal" data-bs-target="#trackerDeleteItemModal">Remove</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit" id="trackerSaveItemBtn">Add item</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="trackerDeleteItemModal" tabindex="-1" aria-labelledby="trackerDeleteItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h2 class="modal-title h5" id="trackerDeleteItemModalLabel">Remove tracker item</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="mb-1">Are you sure you want to remove <strong id="trackerDeleteItemTitle"></strong>?</p>
                <p class="small-muted mt-2 mb-0">This action cannot be undone.</p>

                <form id="trackerDeleteItemForm" class="mt-3">
                    <input type="hidden" id="trackerDeleteItemId" />
                    <button type="button" class="btn btn-outline-danger w-100 position-relative overflow-hidden hold-delete-btn" data-hold-form="trackerDeleteItemForm" data-hold-modal="trackerDeleteItemModal" data-hold-duration-ms="2000">
                        <span class="hold-delete-fill"></span>
                        <span class="hold-delete-label position-relative">Hold to remove</span>
                    </button>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
