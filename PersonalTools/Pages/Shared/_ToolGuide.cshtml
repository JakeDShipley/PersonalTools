@model IReadOnlyList<string>

@if (Model?.Count > 0)
{
    <aside class="tool-guide card border-0 shadow-sm section-spacing" aria-label="How to use this tool">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="tool-guide-icon" aria-hidden="true"><i class="fa-solid fa-route"></i></span>
                <div>
                    <p class="eyebrow mb-1">Quick start</p>
                    <h2 class="h6 mb-0">How it works</h2>
                </div>
            </div>
            <div class="row g-3">
                @for (int index = 0; index < Model.Count; index++)
                {
                    <div class="col-12 col-md">
                        <div class="tool-guide-step">
                            <span class="tool-guide-number">@(index + 1)</span>
                            <p class="mb-0">@Model[index]</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </aside>
}
