@page
@model PersonalTools.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-dashboard.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4">
    @Html.AntiForgeryToken()
    <div class="d-flex align-items-center justify-content-between section-spacing">
        <div>
            <p class="eyebrow mb-1">Dashboard</p>
            <h1 class="h3 mb-0 fw-semibold">Your tools</h1>
        </div>
        <span class="tool-count">@Model.Tools.Count tools</span>
    </div>
    <div class="row g-3 g-lg-4">
        @foreach (var tool in Model.Tools)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <a href="@tool.PageUrl" class="card tool-card h-100 shadow-sm tool-card-action text-decoration-none">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="tool-card-topline">
                            <div class="tool-card-icon">
                            <i class="@tool.IconClass"></i>
                            </div>
                            <i class="fa-solid fa-arrow-up-right-from-square tool-card-arrow"></i>
                        </div>

                        <h2 class="h5 fw-semibold mb-2">@tool.Title</h2>

                        <p class="small-muted flex-grow-1">
                            @tool.Description
                        </p>

                        <span class="tool-card-link mt-3">
                            @tool.ButtonText <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="quick-links-launcher-wrap"><button class="quick-links-launcher" type="button" data-bs-toggle="collapse" data-bs-target="#quickLinksPanel" aria-expanded="false" aria-controls="quickLinksPanel"><i class="fa-solid fa-link"></i><span>Quick links</span><i class="fa-solid fa-chevron-down quick-links-chevron"></i></button></div>
    <div class="collapse" id="quickLinksPanel"><section class="quick-links-panel card border-0 shadow-sm"><div class="card-body p-3 p-lg-4"><div class="d-flex align-items-center justify-content-between gap-3 mb-3"><div><p class="eyebrow mb-1">Your shortcuts</p><h2 class="h5 mb-0">Quick links</h2></div><button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#quickLinkModal"><i class="fa-solid fa-plus me-1"></i>Add link</button></div><div id="quickLinksGrid" class="row g-2" aria-live="polite"><div class="small-muted">Loading your links…</div></div></div></section></div>

    <section class="dashboard-widgets mt-5 pt-2" aria-labelledby="dashboardWidgetsTitle">
        <div class="d-flex align-items-center justify-content-between mb-3"><div><p class="eyebrow mb-1">At a glance</p><h2 class="h4 mb-0" id="dashboardWidgetsTitle">Your space</h2></div><span class="small-muted">Drag widgets to arrange them</span></div>
        <div class="row g-3 dashboard-widget-grid" data-sortable data-sortable-key="personal-tools-dashboard-widgets">
            <div class="col-12 col-lg-4 note-sortable-item" data-sortable-id="weather"><article class="card dashboard-widget h-100"><div class="card-body p-4"><div class="widget-heading"><button class="note-drag-handle" type="button" title="Drag to reorder" aria-label="Drag weather widget"><span></span><i class="fa-solid fa-arrow-right-arrow-left"></i><span></span></button><span>Weather</span></div><div id="weatherWidget" class="weather-widget-content"><form id="weatherLocationForm" class="w-100"><label class="small-muted mb-2" for="weatherLocation">Choose a location</label><div class="input-group"><input id="weatherLocation" class="form-control" placeholder="e.g. London" autocomplete="off" /><button class="btn btn-outline-primary" type="submit">Set</button></div></form></div></div></article></div>
            <div class="col-12 col-lg-5 note-sortable-item" data-sortable-id="calendar"><article class="card dashboard-widget h-100"><div class="card-body p-4"><div class="widget-heading"><button class="note-drag-handle" type="button" title="Drag to reorder" aria-label="Drag calendar widget"><span></span><i class="fa-solid fa-arrow-right-arrow-left"></i><span></span></button><span>Calendar</span><span class="ms-auto small-muted">This month</span></div><div id="dashboardCalendar"></div></div></article></div>
            <div class="col-12 col-lg-3 note-sortable-item" data-sortable-id="recent-notes"><article class="card dashboard-widget h-100"><div class="card-body p-4"><div class="widget-heading"><button class="note-drag-handle" type="button" title="Drag to reorder" aria-label="Drag recent notes widget"><span></span><i class="fa-solid fa-arrow-right-arrow-left"></i><span></span></button><span>Recent notes</span><a asp-page="/Notes/Index" class="ms-auto widget-link">Open</a></div><div id="recentNotesWidget" class="recent-notes-widget" aria-live="polite"><i class="fa-solid fa-circle-notch fa-spin"></i></div></div></article></div>
        </div>
    </section>
</div>

<div class="modal fade" id="quickLinkModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow"><form id="quickLinkForm"><div class="modal-header"><h2 class="modal-title h5" id="quickLinkModalTitle">Add quick link</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input id="quickLinkId" type="hidden" /><div class="mb-3"><label class="form-label" for="quickLinkTitle">Title</label><input id="quickLinkTitle" class="form-control" maxlength="100" required /></div><div class="mb-3"><label class="form-label" for="quickLinkUrl">Website address</label><input id="quickLinkUrl" class="form-control" placeholder="https://example.com" required /></div><div><label class="form-label" for="quickLinkIcon">Font Awesome icon <span class="small-muted">(optional)</span></label><input id="quickLinkIcon" class="form-control" placeholder="fa-solid fa-star" maxlength="100" /></div><div id="quickLinkError" class="alert alert-danger d-none mt-3 mb-0"></div></div><div class="modal-footer"><button id="deleteQuickLink" class="btn btn-outline-danger me-auto d-none" type="button">Remove</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Save link</button></div></form></div></div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.21/index.global.min.js"></script>
    <script src="~/js/pages/page-dashboard.js" asp-append-version="true"></script>
}
