@page
@model PersonalTools.Pages.Monitoring.Database.IndexModel
@{
    ViewData["Title"] = "Database Monitor";
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-monitoring.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4 monitor-page" data-monitor-scope="database" data-monitor-endpoint="/api/monitoring/database">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 section-spacing">
        <div>
            <p class="eyebrow">System</p>
            <h1 class="page-title">Database monitor</h1>
            <p class="page-subtitle mb-0">Live MariaDB health, workload and efficiency signals without exposing database internals.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="monitor-live-state" id="monitorConnectionState">
                <span class="monitor-live-dot"></span>
                <span>Connecting</span>
            </span>

            <button class="btn btn-outline-primary monitor-refresh-button" id="refreshMonitor" type="button">
                <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_ToolGuide", new[]
    {
        "Wait for the database monitor to establish its live sample.",
        "Use the primary cards for capacity and workload, then review efficiency signals for developing issues.",
        "Use Refresh whenever you want a new database reading immediately."
    })

    <div class="monitor-status card border-0 shadow-sm mb-3" id="monitorStatusCard" aria-live="polite" data-monitor-reveal="hero">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div class="d-flex align-items-start align-items-sm-center gap-3">
                    <span class="monitor-status-icon flex-shrink-0">
                        <i class="fa-solid fa-database" aria-hidden="true"></i>
                    </span>

                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0">Database health</h2>
                            <span class="badge monitor-health-badge" id="monitorHealth">Loading</span>
                        </div>

                        <p class="small-muted mb-0" id="monitorSummary">Collecting a restricted database health snapshot.</p>

                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                            <span class="badge rounded-pill text-bg-light border">
                                <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>
                                Restricted view
                            </span>

                            <span class="badge rounded-pill text-bg-light border" id="monitorSampleMode">
                                <i class="fa-solid fa-wave-square me-1" aria-hidden="true"></i>
                                <span id="monitorSampleLabel">Baseline sample</span>
                            </span>
                        </div>
                    </div>
                </div>

                <small class="small-muted text-nowrap">
                    Updated <span id="monitorUpdated">—</span>
                </small>
            </div>
        </div>
    </div>

    <div class="alert alert-warning border-0 shadow-sm d-none" id="monitorUnavailable" role="status">
        <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
        The database monitor is unavailable. Confirm that the monitoring stored procedure has been imported; internal connection details remain hidden.
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="primary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                        </span>

                        <span>Response time</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Time taken to obtain the restricted database monitoring snapshot. It includes database connection and procedure execution time.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="responseTimeMs">—</div>
                    <div class="monitor-metric-caption">milliseconds</div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="primary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-plug-circle-bolt" aria-hidden="true"></i>
                        </span>

                        <span>Connection use</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The percentage of configured MariaDB connection capacity currently occupied. The actual configured limit is not exposed by the API.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="connectionUsagePercent">—</div>

                    <div class="progress monitor-progress" role="progressbar" aria-label="Database connection use" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" data-database-bar="connectionUsagePercent"></div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="primary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-wave-square" aria-hidden="true"></i>
                        </span>

                        <span>Query activity</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Database statements per second. After a second snapshot this becomes a recent interval rate rather than a lifetime average.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="queriesPerSecond">—</div>
                    <div class="monitor-metric-caption" data-database-caption="queriesPerSecond">average per second</div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="primary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        </span>

                        <span>Schema readiness</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Confirms that the application's required database structures are present without returning their names or definitions to the browser.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="structures">—</div>
                    <div class="monitor-metric-caption">required structures ready</div>
                </div>
            </article>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mt-4 mb-3" data-monitor-reveal="secondary">
        <div>
            <p class="eyebrow mb-1">Efficiency</p>
            <h2 class="h5 mb-0">How MariaDB is behaving</h2>
        </div>

        <span class="small-muted">Recent interval signals appear once a second snapshot is available.</span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm" data-database-signal="bufferPoolHitPercent">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-memory" aria-hidden="true"></i>
                        </span>

                        <span>Buffer-pool hit</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The share of InnoDB read requests served without needing a physical disk read. Higher is better.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="bufferPoolHitPercent">—</div>

                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <span class="monitor-metric-caption mb-0">reads served efficiently</span>
                        <span class="badge monitor-health-badge" data-signal-badge>Baseline</span>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm" data-database-signal="diskTempTablePercent">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-hard-drive" aria-hidden="true"></i>
                        </span>

                        <span>Temp tables on disk</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The share of internal temporary tables created on disk instead of remaining in memory. Lower is generally better.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="diskTempTablePercent">—</div>

                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <span class="monitor-metric-caption mb-0">temporary-table share</span>
                        <span class="badge monitor-health-badge" data-signal-badge>Baseline</span>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm" data-database-signal="threadCreationPercent">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
                        </span>

                        <span>Thread creation</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The percentage of connection attempts that required MariaDB to create a new worker thread. A low rate normally indicates effective thread reuse.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="threadCreationPercent">—</div>

                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <span class="monitor-metric-caption mb-0">new threads per connection</span>
                        <span class="badge monitor-health-badge" data-signal-badge>Baseline</span>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm" data-database-signal="activeRowLockWaits">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-lock" aria-hidden="true"></i>
                        </span>

                        <span>Row-lock waits</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The number of operations currently waiting to obtain an InnoDB row lock. A sustained non-zero value can indicate contention.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-database-value="activeRowLockWaits">—</div>

                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <span class="monitor-metric-caption mb-0">currently waiting</span>
                        <span class="badge monitor-health-badge" data-signal-badge>Checking</span>
                    </div>
                </div>
            </article>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-8" data-monitor-reveal="secondary">
            <section class="card monitor-panel h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-3 mb-3">
                        <div>
                            <h2 class="h5 mb-1">Live responsiveness</h2>
                            <p class="small-muted mb-0">Response time and connection pressure held temporarily in this browser tab.</p>
                        </div>

                        <span class="badge rounded-pill text-bg-light border align-self-start">Last 20 samples</span>
                    </div>

                    <div class="monitor-chart-wrap">
                        <canvas id="databaseMonitorChart"></canvas>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4" data-monitor-reveal="secondary">
            <section class="card monitor-panel h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-1">Operational signals</h2>
                    <p class="small-muted mb-4">A compact view of current activity and recent database traffic.</p>

                    <div class="monitor-detail-list">
                        <div class="monitor-detail">
                            <span><i class="fa-solid fa-gears" aria-hidden="true"></i>Running operations</span>
                            <strong data-database-detail="runningOperations">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>Service uptime</span>
                            <strong data-database-detail="uptimeSeconds">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span><i class="fa-solid fa-gauge-simple-low" aria-hidden="true"></i>Slow-query rate</span>
                            <strong data-database-detail="slowQueryPercent">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span><i class="fa-solid fa-link-slash" aria-hidden="true"></i>Failed connections</span>
                            <strong data-database-detail="connectionErrorPercent">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span><i class="fa-solid fa-arrow-down" aria-hidden="true"></i>Traffic received</span>
                            <strong data-database-detail="networkReceive">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span><i class="fa-solid fa-arrow-up" aria-hidden="true"></i>Traffic sent</span>
                            <strong data-database-detail="networkSend">—</strong>
                        </div>
                    </div>

                    <div class="monitor-privacy-note mt-4">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        <span>Database names, versions, users, SQL text, table names and stored-procedure names are never included in the browser response.</span>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/pages/page-database-monitor.js" asp-append-version="true"></script>
}