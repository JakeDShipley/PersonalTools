@page
@model PersonalTools.Pages.Monitoring.Database.IndexModel
@{
    ViewData["Title"] = "Database Monitor";
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-monitoring.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4 monitor-page" data-monitor-scope="database" data-monitor-endpoint="/api/monitoring/database">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 section-spacing">
        <div>
            <p class="eyebrow">System</p>
            <h1 class="page-title">Database monitor</h1>
            <p class="page-subtitle mb-0">Live MariaDB health signals, intentionally limited to safe operational summaries.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="monitor-live-state" id="monitorConnectionState"><span class="monitor-live-dot"></span><span>Connecting</span></span>
            <button class="btn btn-outline-primary monitor-refresh-button" id="refreshMonitor" type="button"><i class="fa-solid fa-rotate"></i><span>Refresh</span></button>
        </div>
    </div>

    <div class="monitor-status card border-0 shadow-sm mb-3" id="monitorStatusCard" aria-live="polite">
        <div class="card-body p-3 p-lg-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="monitor-status-icon"><i class="fa-solid fa-database"></i></span>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1"><h2 class="h5 mb-0">Database health</h2><span class="badge monitor-health-badge" id="monitorHealth">Loading</span></div>
                    <p class="small-muted mb-0" id="monitorSummary">Checking the database through its restricted monitoring procedure.</p>
                </div>
            </div>
            <small class="small-muted text-nowrap">Updated <span id="monitorUpdated">—</span></small>
        </div>
    </div>

    <div class="alert alert-warning border-0 shadow-sm d-none" id="monitorUnavailable" role="status">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>The database monitor is unavailable. Confirm that the monitoring stored procedure has been imported; internal connection details remain hidden.
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm"><div class="card-body p-4">
                <div class="monitor-metric-heading"><span class="monitor-metric-icon"><i class="fa-solid fa-bolt"></i></span><span>Response time</span><button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Time taken to connect and execute the restricted health procedure. It does not include page rendering."><i class="fa-solid fa-circle-info"></i></button></div>
                <div class="monitor-metric-value" data-database-value="responseTimeMs">—</div><div class="monitor-metric-caption">milliseconds</div>
            </div></article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm"><div class="card-body p-4">
                <div class="monitor-metric-heading"><span class="monitor-metric-icon"><i class="fa-solid fa-plug-circle-bolt"></i></span><span>Connection use</span><button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The percentage of configured database connections currently occupied. Exact connection limits are not exposed."><i class="fa-solid fa-circle-info"></i></button></div>
                <div class="monitor-metric-value" data-database-value="connectionUsagePercent">—</div>
                <div class="progress monitor-progress" role="progressbar" aria-label="Database connection use" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" data-database-bar="connectionUsagePercent"></div></div>
            </div></article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm"><div class="card-body p-4">
                <div class="monitor-metric-heading"><span class="monitor-metric-icon"><i class="fa-solid fa-wave-square"></i></span><span>Query activity</span><button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The average number of database statements handled per second since the database service started."><i class="fa-solid fa-circle-info"></i></button></div>
                <div class="monitor-metric-value" data-database-value="queriesPerSecond">—</div><div class="monitor-metric-caption">average per second</div>
            </div></article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm"><div class="card-body p-4">
                <div class="monitor-metric-heading"><span class="monitor-metric-icon"><i class="fa-solid fa-list-check"></i></span><span>Schema readiness</span><button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Confirms that the application’s required data structures are present without revealing their internal names or definitions."><i class="fa-solid fa-circle-info"></i></button></div>
                <div class="monitor-metric-value" data-database-value="structures">—</div><div class="monitor-metric-caption">required structures ready</div>
            </div></article>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <section class="card monitor-panel h-100 border-0 shadow-sm"><div class="card-body p-4">
                <div class="d-flex align-items-start justify-content-between gap-3 mb-3"><div><h2 class="h5 mb-1">Live responsiveness</h2><p class="small-muted mb-0">A temporary chart held only in this browser tab.</p></div><span class="badge rounded-pill text-bg-light border">Last 20 samples</span></div>
                <div class="monitor-chart-wrap"><canvas id="databaseMonitorChart"></canvas></div>
            </div></section>
        </div>
        <div class="col-12 col-xl-4">
            <section class="card monitor-panel h-100 border-0 shadow-sm"><div class="card-body p-4">
                <h2 class="h5 mb-1">Operational signals</h2><p class="small-muted mb-4">Aggregated indicators only—never queries, credentials or configuration.</p>
                <div class="monitor-detail-list">
                    <div class="monitor-detail"><span><i class="fa-solid fa-gears"></i>Running operations</span><strong data-database-detail="runningOperations">—</strong></div>
                    <div class="monitor-detail"><span><i class="fa-solid fa-clock-rotate-left"></i>Service uptime</span><strong data-database-detail="uptimeSeconds">—</strong></div>
                    <div class="monitor-detail"><span><i class="fa-solid fa-gauge-simple-low"></i>Slow-query rate</span><strong data-database-detail="slowQueryPercent">—</strong></div>
                    <div class="monitor-detail"><span><i class="fa-solid fa-link-slash"></i>Connection-error rate</span><strong data-database-detail="connectionErrorPercent">—</strong></div>
                </div>
                <div class="monitor-privacy-note mt-4"><i class="fa-solid fa-shield-halved"></i><span>Database names, versions, users, SQL text, table names and stored-procedure names are not included in the API response.</span></div>
            </div></section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/pages/page-database-monitor.js" asp-append-version="true"></script>
}
