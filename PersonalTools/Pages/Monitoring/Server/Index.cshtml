@page
@model PersonalTools.Pages.Monitoring.Server.IndexModel
@{
    ViewData["Title"] = "Server Monitor";
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-monitoring.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4 monitor-page" data-monitor-scope="server" data-monitor-endpoint="/api/monitoring/server">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 section-spacing">
        <div>
            <p class="eyebrow">System</p>
            <h1 class="page-title">Server monitor</h1>
            <p class="page-subtitle mb-0">Live host pressure and Personal Tools process activity in one read-only view.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="monitor-live-state" id="monitorConnectionState">
                <span class="monitor-live-dot"></span>
                <span>Connecting</span>
            </span>

            <button class="btn btn-outline-primary monitor-refresh-button" id="refreshMonitor" type="button">
                <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_ToolGuide", new[]
    {
        "Use Host resources to see overall CPU, physical-memory and storage pressure.",
        "Use Personal Tools footprint to separate this application's usage from the rest of the server.",
        "Use Refresh whenever you want a new reading immediately."
    })

    <div class="monitor-status card border-0 shadow-sm mb-3" id="monitorStatusCard" aria-live="polite" data-monitor-reveal="hero">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div class="d-flex align-items-start align-items-sm-center gap-3">
                    <span class="monitor-status-icon flex-shrink-0">
                        <i class="fa-solid fa-shield-heart" aria-hidden="true"></i>
                    </span>

                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0">Operational health</h2>
                            <span class="badge monitor-health-badge" id="monitorHealth">Loading</span>
                        </div>

                        <p class="small-muted mb-0" id="monitorSummary">Collecting a restricted server health snapshot.</p>

                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                            <span class="badge rounded-pill text-bg-light border">
                                <i class="fa-solid fa-eye me-1" aria-hidden="true"></i>
                                Read-only
                            </span>

                            <span class="badge rounded-pill text-bg-light border" id="monitorProcessSample">
                                <i class="fa-solid fa-wave-square me-1" aria-hidden="true"></i>
                                <span id="monitorProcessSampleLabel">Process sampling</span>
                            </span>
                        </div>
                    </div>
                </div>

                <small class="small-muted text-nowrap">
                    Updated <span id="monitorUpdated">—</span>
                </small>
            </div>
        </div>
    </div>

    <div class="alert alert-warning border-0 shadow-sm d-none" id="monitorUnavailable" role="status">
        <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
        Live server metrics are temporarily unavailable. No host identity or configuration details have been exposed.
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mt-4 mb-3" data-monitor-reveal="primary">
        <div>
            <p class="eyebrow mb-1">Host resources</p>
            <h2 class="h5 mb-0">Overall server pressure</h2>
        </div>

        <span class="small-muted">These values cover the host, not only Personal Tools.</span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4" data-monitor-reveal="primary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-microchip" aria-hidden="true"></i>
                        </span>

                        <span>Host CPU load</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Overall processor utilisation across the host. This includes Personal Tools and other operating-system or service activity.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-server-value="cpuUsagePercent">—</div>

                    <div class="progress monitor-progress" role="progressbar" aria-label="Host CPU load" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" data-server-bar="cpuUsagePercent"></div>
                    </div>

                    <div class="monitor-metric-caption mt-2">whole server</div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-4" data-monitor-reveal="primary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-memory" aria-hidden="true"></i>
                        </span>

                        <span>Host memory use</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Physical memory currently in use across the whole host, including the operating system and every running service. This is not Personal Tools memory usage.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-server-value="memoryUsagePercent">—</div>

                    <div class="progress monitor-progress" role="progressbar" aria-label="Host memory use" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" data-server-bar="memoryUsagePercent"></div>
                    </div>

                    <div class="monitor-metric-caption mt-2">whole server, not this app</div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-4" data-monitor-reveal="primary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-hard-drive" aria-hidden="true"></i>
                        </span>

                        <span>Storage use</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The percentage of the storage volume containing Personal Tools that is currently occupied. Exact capacity and path details remain hidden.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-server-value="storageUsagePercent">—</div>

                    <div class="progress monitor-progress" role="progressbar" aria-label="Storage use" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" data-server-bar="storageUsagePercent"></div>
                    </div>

                    <div class="monitor-metric-caption mt-2">application volume</div>
                </div>
            </article>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mt-4 mb-3" data-monitor-reveal="secondary">
        <div>
            <p class="eyebrow mb-1">Personal Tools</p>
            <h2 class="h5 mb-0">Application footprint</h2>
        </div>

        <span class="small-muted">Process-level activity separated from host-wide usage.</span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                        </span>

                        <span>Application CPU</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Processor time used by Personal Tools as a percentage of the total CPU capacity available to this process. The first sample needs another reading before this can be calculated.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-server-value="applicationCpuUsagePercent">—</div>

                    <div class="progress monitor-progress" role="progressbar" aria-label="Personal Tools CPU use" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" data-server-bar="applicationCpuUsagePercent"></div>
                    </div>

                    <div class="monitor-metric-caption mt-2">of CPU available to app</div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                        </span>

                        <span>Working set</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Physical memory currently resident for the Personal Tools process. It includes managed, native and shared process pages.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-server-value="applicationMemoryBytes">—</div>
                    <div class="monitor-metric-caption">physical process memory</div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-code" aria-hidden="true"></i>
                        </span>

                        <span>Managed heap</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="Approximate managed .NET heap size excluding fragmentation. This is only the managed portion of the application's overall working set.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-server-value="managedMemoryBytes">—</div>
                    <div class="monitor-metric-caption">managed .NET memory</div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-3" data-monitor-reveal="secondary">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon">
                            <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
                        </span>

                        <span>Host RAM share</span>

                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The Personal Tools working set as a percentage of the host's physical memory. Because working sets can include shared pages, this is a useful footprint indicator rather than an exclusive ownership figure.">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="monitor-metric-value" data-server-value="applicationMemorySharePercent">—</div>
                    <div class="monitor-metric-caption">application working-set share</div>
                </div>
            </article>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-8" data-monitor-reveal="secondary">
            <section class="card monitor-panel h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-3 mb-3">
                        <div>
                            <h2 class="h5 mb-1">Host resource activity</h2>
                            <p class="small-muted mb-0">A browser-only history of CPU, memory and storage pressure during this session.</p>
                        </div>

                        <span class="badge rounded-pill text-bg-light border align-self-start">Last 20 samples</span>
                    </div>

                    <div class="monitor-chart-wrap">
                        <canvas id="serverMonitorChart"></canvas>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4" data-monitor-reveal="secondary">
            <section class="card monitor-panel h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-1">Application runtime</h2>
                    <p class="small-muted mb-4">Useful process context without identifying the host or exposing configuration.</p>

                    <div class="monitor-detail-list">
                        <div class="monitor-detail">
                            <span>
                                <i class="fa-solid fa-clock" aria-hidden="true"></i>
                                Application uptime
                            </span>
                            <strong data-server-detail="applicationUptimeSeconds">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span>
                                <i class="fa-solid fa-microchip" aria-hidden="true"></i>
                                Processors available
                            </span>
                            <strong data-server-detail="availableProcessorCount">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span>
                                <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
                                Process threads
                            </span>
                            <strong data-server-detail="processThreadCount">—</strong>
                        </div>

                        <div class="monitor-detail">
                            <span>
                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                Exposure policy
                            </span>
                            <strong>Restricted</strong>
                        </div>
                    </div>

                    <div class="monitor-privacy-note mt-4">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        <span>Host identity, network information, software versions, paths and exact hardware capacities are never returned to this page.</span>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/pages/page-server-monitor.js" asp-append-version="true"></script>
}