@page
@model PersonalTools.Pages.Monitoring.Server.IndexModel
@{
    ViewData["Title"] = "Server Monitor";
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/page-monitoring.css" asp-append-version="true" />
}

<div class="container px-3 px-lg-4 monitor-page" data-monitor-scope="server" data-monitor-endpoint="/api/monitoring/server">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 section-spacing">
        <div>
            <p class="eyebrow">System</p>
            <h1 class="page-title">Server monitor</h1>
            <p class="page-subtitle mb-0">A live, read-only view of the resources supporting Personal Tools.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="monitor-live-state" id="monitorConnectionState"><span class="monitor-live-dot"></span><span>Connecting</span></span>
            <button class="btn btn-outline-primary monitor-refresh-button" id="refreshMonitor" type="button">
                <i class="fa-solid fa-rotate" aria-hidden="true"></i><span>Refresh</span>
            </button>
        </div>
    </div>

    <div class="monitor-status card border-0 shadow-sm mb-3" id="monitorStatusCard" aria-live="polite">
        <div class="card-body p-3 p-lg-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="monitor-status-icon"><i class="fa-solid fa-shield-heart"></i></span>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="h5 mb-0">Operational health</h2>
                        <span class="badge monitor-health-badge" id="monitorHealth">Loading</span>
                    </div>
                    <p class="small-muted mb-0" id="monitorSummary">Collecting a safe server snapshot.</p>
                </div>
            </div>
            <small class="small-muted text-nowrap">Updated <span id="monitorUpdated">—</span></small>
        </div>
    </div>

    <div class="alert alert-warning border-0 shadow-sm d-none" id="monitorUnavailable" role="status">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>Live metrics are temporarily unavailable. Personal Tools remains protected and no technical details have been exposed.
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon"><i class="fa-solid fa-microchip"></i></span>
                        <span>Processor load</span>
                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The percentage of available processing capacity currently in use. A brief spike is normal."><i class="fa-solid fa-circle-info"></i></button>
                    </div>
                    <div class="monitor-metric-value" data-server-value="cpuUsagePercent">—</div>
                    <div class="progress monitor-progress" role="progressbar" aria-label="Processor load" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" data-server-bar="cpuUsagePercent"></div></div>
                </div>
            </article>
        </div>
        <div class="col-12 col-md-4">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon"><i class="fa-solid fa-memory"></i></span>
                        <span>Memory pressure</span>
                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The proportion of physical memory currently being used by the system."><i class="fa-solid fa-circle-info"></i></button>
                    </div>
                    <div class="monitor-metric-value" data-server-value="memoryUsagePercent">—</div>
                    <div class="progress monitor-progress" role="progressbar" aria-label="Memory pressure" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" data-server-bar="memoryUsagePercent"></div></div>
                </div>
            </article>
        </div>
        <div class="col-12 col-md-4">
            <article class="card monitor-metric-card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="monitor-metric-heading">
                        <span class="monitor-metric-icon"><i class="fa-solid fa-hard-drive"></i></span>
                        <span>Storage use</span>
                        <button class="monitor-info" type="button" data-bs-toggle="tooltip" title="The percentage of the application's storage volume currently occupied. Capacity details are intentionally hidden."><i class="fa-solid fa-circle-info"></i></button>
                    </div>
                    <div class="monitor-metric-value" data-server-value="storageUsagePercent">—</div>
                    <div class="progress monitor-progress" role="progressbar" aria-label="Storage use" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" data-server-bar="storageUsagePercent"></div></div>
                </div>
            </article>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <section class="card monitor-panel h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                        <div><h2 class="h5 mb-1">Resource activity</h2><p class="small-muted mb-0">A short browser-only history of this open session.</p></div>
                        <span class="badge rounded-pill text-bg-light border">Last 20 samples</span>
                    </div>
                    <div class="monitor-chart-wrap"><canvas id="serverMonitorChart"></canvas></div>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-4">
            <section class="card monitor-panel h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h5 mb-1">Application runtime</h2>
                    <p class="small-muted mb-4">Process-level details that are useful without identifying the host.</p>
                    <div class="monitor-detail-list">
                        <div class="monitor-detail"><span><i class="fa-solid fa-clock"></i>Application uptime</span><strong data-server-detail="applicationUptimeSeconds">—</strong></div>
                        <div class="monitor-detail"><span><i class="fa-solid fa-layer-group"></i>Application memory</span><strong data-server-detail="applicationMemoryBytes">—</strong></div>
                        <div class="monitor-detail"><span><i class="fa-solid fa-code"></i>Managed memory</span><strong data-server-detail="managedMemoryBytes">—</strong></div>
                        <div class="monitor-detail"><span><i class="fa-solid fa-lock"></i>Exposure policy</span><strong>Restricted</strong></div>
                    </div>
                    <div class="monitor-privacy-note mt-4"><i class="fa-solid fa-shield-halved"></i><span>Host identity, network, software-version and configuration details are never returned to this page.</span></div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/pages/page-server-monitor.js" asp-append-version="true"></script>
}
