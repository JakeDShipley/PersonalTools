@page
@model PersonalTools.Pages.SetupModel
@{ ViewData["Title"] = "Set up"; }
<div class="container px-3 px-lg-4"><div class="row justify-content-center"><div class="col-12 col-sm-10 col-md-8 col-lg-6"><div class="card shadow-sm border-0"><div class="card-body p-4 p-lg-5"><p class="eyebrow">First-time setup</p><h1 class="h3 fw-semibold">Create the owner account</h1><p class="small-muted mb-4">This page becomes unavailable as soon as an account exists.</p>@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="alert alert-danger">@Model.ErrorMessage</div>}<form method="post"><div class="row g-3"><div class="col-12"><label asp-for="DisplayName" class="form-label">Display name</label><input asp-for="DisplayName" class="form-control" required /></div><div class="col-12"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" required /></div><div class="col-12 col-md-6"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" minlength="12" required /></div><div class="col-12 col-md-6"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" type="password" class="form-control" minlength="12" required /></div><div class="col-12"><button class="btn btn-primary w-100" type="submit">Create account</button></div></div></form></div></div></div></div></div>
